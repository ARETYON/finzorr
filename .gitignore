# Environment files — never commit real secrets (public repo)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Node
node_modules/
frontend/dist/

# Local data / runtime artifacts
backend/storage/
*.sqlite3
dump.rdb

# OS / editor
.DS_Store
.idea/
.vscode/

# Word/doc build artifacts stay out of git (the .md files are the source;
# regenerate with: pandoc <name>.md -o <name>.docx --standalone -f gfm)
PROJECT_PLAN.docx
~$*
DEPLOYMENT_PLAN.docx
IMPROVEMENTS_SUMMARY.docx
drift/
