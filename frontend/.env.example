# Frontend build-time configuration (Vite). Copy to .env.local for overrides.
# Comments must be on their own line.

# Backend API origin. Empty in dev (Vite proxies /api and /ws to the backend).
# UAT/PROD set this to the API origin, e.g. https://api.finzorr.ai
VITE_API_BASE_URL=

# Google Identity Services OAuth client id (same client as the backend's
# GOOGLE_CLIENT_ID). Empty hides the Google button (dev bypass still works).
VITE_GOOGLE_CLIENT_ID=
