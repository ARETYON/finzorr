# finzorr.ai backend — every env var read in code MUST appear here (CI-checked).
# Copy to .env for local dev. NEVER commit a real .env (public repo).
# NOTE: keep comments on their own lines — inline comments after empty values
# are read as the value by the env-file parser.

# --- Environment: dev | uat | prod ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- Data stores (docker-compose.dev.yml defaults) ---
DATABASE_URL=postgresql+asyncpg://finzorr:finzorr@localhost:5433/finzorr
NL2SQL_RO_DATABASE_URL=postgresql+asyncpg://finzorr_nl2sql_ro:nl2sql_ro@localhost:5433/finzorr
REDIS_URL=redis://localhost:6380/0
QDRANT_URL=http://localhost:6335
QDRANT_API_KEY=

# --- LLM providers (free chain: groq -> gemini -> openrouter -> ollama) ---
# LLM_PROVIDER: ollama | groq | gemini | openrouter | huggingface
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b-instruct
# Optional: one bounded retry against this provider on failure/budget exhaustion
LLM_FALLBACK_PROVIDER=
# Small/fast model for supervisor routing; empty = LLM_MODEL
SUPERVISOR_MODEL=
OLLAMA_URL=http://localhost:11434
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b

# --- Embeddings (host Ollama in dev; ollama-embed container in uat/prod) ---
EMBED_OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text:v1.5
EMBED_DIM=768

# --- Auth ---
GOOGLE_CLIENT_ID=
SESSION_SECRET=dev-only-change-me
SESSION_TTL_DAYS=7
# DEV_FAKE_AUTH is only honored when APP_ENV=dev
DEV_FAKE_AUTH=true
# COOKIE_DOMAIN: ".finzorr.ai" in uat/prod; leave empty locally
COOKIE_DOMAIN=

# --- Frontend / CORS / WS origin check ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Rate limits & quotas ---
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_S=300
# Per provider per day; 0 disables
DAILY_TOKEN_BUDGET=2000000

# --- Web search (all optional; DuckDuckGo works keyless) ---
TAVILY_API_KEY=
SEARXNG_URL=

# --- Documents ---
DOCUMENT_STORAGE_DIR=storage/uploads
MAX_UPLOAD_MB=10
MAX_UPLOAD_PAGES=100
MAX_DOCS_PER_USER=20

# --- External tool integrations (optional) ---
GITHUB_TOKEN=
MICROSERVICE_TOOLS_CONFIG=
