        </mxCell>
        <mxCell id="p3_c5" value="ollama&#xa;~3GB cap&#xa;local embedder + one small emergency chat model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
