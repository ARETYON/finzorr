        <mxCell id="p20_ex_spec2" value="Large model verifies all 4 in ONE pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="205" y="1536" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p20_ex_spec3" value="3 accepted, 1 corrected (&quot;gained&quot;→&quot;rose&quot;) — ~2-3x faster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
