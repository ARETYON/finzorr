        <mxCell id="p20_ex_spec_e2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p20_ex_spec2" target="p20_ex_spec3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p20_ex_ctx_lbl" value="CONTEXT WINDOW COST — n vs 10×n" style="text;html=1;fontSize=11;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="580" y="1514" width="510" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p20_ex_ctx1" value="n = 100 tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="580" y="1536" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p20_ex_ctx2" value="attention cost ≈ n² = 10,000 units" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
