          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p18_eloop" value="loop: predict → append → predict ... until &lt;stop&gt;" style="endArrow=block;html=1;dashed=1;strokeColor=#7e57c2;fontSize=10;" edge="1" parent="1" source="p18_app2" target="p18_pred2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="465" y="415" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
