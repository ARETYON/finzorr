        <mxCell id="p12_sub2" value="CI/CD — self-hosted GitHub Actions runner ON the server, the same outbound-only shape as the tunnel" style="text;html=1;fontSize=12;fontStyle=1;align=left;fontColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="30" y="375" width="1000" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p12_runner" value="Self-hosted GitHub Actions runner&#xa;&#xa;Runs ON the server as a systemd service. Polls GitHub OUTBOUND — same shape as the cloudflared tunnel, adds ZERO new inbound exposure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="400" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p12_push" value="Push to main&#xa;&#xa;Triggers the cd-prod workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="390" y="400" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p12_build" value="build-and-push job&#xa;&#xa;GitHub-hosted runner&#xa;Builds the image, pushes to GHCR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="610" y="400" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p12_gate" value="Production Environment gate&#xa;&#xa;Required-reviewer approval — gates the deploy job before it can run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="400" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p12_deploy" value="deploy job&#xa;&#xa;Runs on the self-hosted runner (on the server) — executes deploy.sh with a tag argument, locally" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1190" y="400" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p12_token" value="No SSH deploy key&#xa;&#xa;NO SSH deploy key ever lives in GitHub — only the built-in, auto-rotated GITHUB_TOKEN, used solely to push the image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1480" y="400" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p12_e9" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p12_push" target="p12_build">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12_e10" style="endArrow=block;html=1;strokeColor=#d6b656;" edge="1" parent="1" source="p12_build" target="p12_gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12_e11" style="endArrow=block;html=1;strokeColor=#d6b656;" edge="1" parent="1" source="p12_gate" target="p12_deploy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12_e12" value="hosts" style="endArrow=block;html=1;dashed=1;strokeColor=#5f6368;fontSize=10;" edge="1" parent="1" source="p12_runner" target="p12_deploy">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="195" y="530" />
              <mxPoint x="1320" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p12_sub3" value="SECURITY POSTURE — real OWASP LLM Top 10 disposition, from SECURITY_REVIEW.md" style="text;html=1;fontSize=12;fontStyle=1;align=left;fontColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="30" y="540" width="1000" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p12_sec1" value="Prompt Injection (LLM01)&#xa;&#xa;Layered untrusted-content fencing + guard pattern-floor + optional LLM tier + write-time reject on persona/instructions + a 76-check eval gated at 100%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="565" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p12_sec2" value="Insecure Output Handling (LLM02)&#xa;&#xa;No SQL/HTML injection paths exist; output is screened for secrets, system-prompt echo, and degenerate text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="565" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p12_sec3" value="Model Denial of Service (LLM04)&#xa;&#xa;Bounded by a 300-second per-turn wall clock, per-tool-family timeouts, per-user rate limits, and daily token budgets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="870" y="565" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p12_sec4" value="Sensitive Info Disclosure (LLM06)&#xa;&#xa;Limited by tenant-isolated retrieval (seam-tested), PII redaction, and LangSmith tracing OFF by default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1290" y="565" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p12_sec5" value="Insecure Plugin Design (LLM07)&#xa;&#xa;Addressed with schema-validated tool args, a sandboxed non-root code interpreter, and a read-only GitHub MCP allowlist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="735" width="540" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p12_sec6" value="Excessive Agency (LLM08)&#xa;&#xa;Bounded by HITL interrupt-based approval for sensitive tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="590" y="735" width="540" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p12_sec7" value="Overreliance (LLM09)&#xa;&#xa;Addressed with citations carrying exact locators, an honest refusal on zero-source research, and a not-investment-advice disclaimer on every finance answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1150" y="735" width="540" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p12_sub4" value="REAL PRODUCTION INCIDENTS — FOUND AND FIXED (the richest, most hard-won section of this atlas)" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#c5221f;" vertex="1" parent="1">
          <mxGeometry x="30" y="892" width="1200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p12_inc1" value="1. Disk exhaustion — first production build&#xa;&#xa;Root cause: the Docker build installed build-essential (a full C compiler toolchain, ~336MB) even though every real dependency ships pre-built manylinux wheels needing zero compilation.&#xa;&#xa;Fix: removed build-essential — fixed the failure at its root, not by just asking for more disk." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="930" width="320" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p12_inc2" value="2. Missing EMBED_OLLAMA_URL / OLLAMA_URL in prod.env&#xa;&#xa;Root cause: the api container defaulted to localhost for the embedder — inside its own container network namespace, localhost means itself, not the ollama container. Failed with &quot;All connection attempts failed&quot;, no obvious networking hint.&#xa;&#xa;Fix: added both vars to the env template; a one-off recovery script exists for any server bootstrapped before the fix." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="366" y="930" width="320" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p12_inc3" value="3. Checkpointer cross-worker deadlock&#xa;&#xa;Root cause: with --workers 2, both uvicorn PROCESSES raced to run CREATE INDEX CONCURRENTLY on first request. An in-process asyncio Lock gives zero protection across separate OS processes, and CREATE INDEX CONCURRENTLY cannot run inside a transaction at all without an explicit autocommit=True on the connection pool. Every chat turn silently hung forever, with no error.&#xa;&#xa;Fix: moved index setup to a genuine one-off single-process step BEFORE workers start; a dedicated recovery script exists for a server already stuck in this state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="702" y="930" width="320" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p12_inc4" value="4. Non-root container could not write to /app&#xa;&#xa;Root cause: a Docker layering subtlety — WORKDIR creates a directory as root BEFORE a later COPY --chown can fix its ownership, and chown only affects the files being copied IN, not the pre-existing directory itself. Broke both file uploads and the stock-price cache.&#xa;&#xa;Fix: added an explicit chown step after the copy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1038" y="930" width="320" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p12_inc5" value="5. First local-only bootstrap image tag broke deploy.sh&#xa;&#xa;Root cause: deploy.sh&#39;s first step (a compose pull) correctly fails against a tag that was never pushed to a registry.&#xa;&#xa;Fix: extracted shared health-wait logic into its own script, so day-0 bring-up and day-2 redeploy don&#39;t have to share a script that assumes an image is always pullable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1374" y="930" width="320" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p12_inc6" value="6. Pre-existing, previously-undetected CI/CD break&#xa;&#xa;Root cause: the production build job used a Docker cache backend that the default buildx driver does not support — silently broken until it blocked two real, unrelated production fixes in a row.&#xa;&#xa;Fix: added the correct buildx setup step." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="1210" width="320" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p12_inc7" value="7. Self-hosted runner silently went unregistered&#xa;&#xa;Root cause: a queued deploy job shows NO error of any kind in the GitHub UI — it just waits forever. Discovered only by directly querying the runner API and finding zero registered runners.&#xa;&#xa;NOT YET FIXED at the infrastructure level (needs direct server access); worked around with a documented emergency manual-deploy procedure run directly on the server." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="366" y="1210" width="320" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p12_inc8" value="8. Uploaded files lost on every container restart&#xa;&#xa;Root cause: files were not on a persistent volume while their vector-search entries survived — silently producing permanently broken citations (a RAG answer citing a source file that no longer exists).&#xa;&#xa;Fix: a proper named Docker volume, verified by actually writing a file as the real non-root container user and reading it back from a completely fresh container instance on the same volume." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="702" y="1210" width="320" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p12_inc9" value="9. Two separate Google OAuth origin_mismatch failures&#xa;&#xa;Root cause: the apex domain and the www subdomain are genuinely different origins to Google&#39;s OAuth check, even though the app&#39;s own CORS/cookie handling treats them as the same site.&#xa;&#xa;Fix: both had to be registered as explicit, separate Authorized JavaScript Origins." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1038" y="1210" width="320" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p12_inc10" value="10. Local dev-machine Docker disk bloat crashed an unrelated container&#xa;&#xa;Root cause: 46GB of accumulated build cache and superseded images on a local development machine crashed an unrelated local Postgres container mid-session.&#xa;&#xa;Lesson: &quot;no space left on device&quot; inside a container does not mean the HOST disk is full — Docker Desktop imposes its own separate internal storage ceiling." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1374" y="1210" width="320" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p12_gap" value="OPEN GAP — honestly marked, not yet solved&#xa;&#xa;deploy/backup.sh — automated nightly Postgres backup does NOT exist yet. A manual pg_dump is today&#39;s real stopgap. This is a genuine currently-open item, not a solved problem." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#d79b00;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="1500" width="800" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p12_legend" value="HOW TO READ THIS PAGE&#xa;&#xa;■ green = LIVE, actually built &amp; running today&#xa;▢ amber dashed = PLANNED / honest open gap&#xa;■ blue = process / service      ■ teal = entry / user-facing&#xa;■ yellow = decision point      ■ purple = output / synthesis&#xa;■ red = risk / incident (root cause + fix)      ■ gray = reference panel&#xa;● numbered circle = request-flow order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="850" y="1500" width="840" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p13" name="13 · Whiteboard — Transformer &amp; LLM Internals">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p13_t" value="WHITEBOARD — TRANSFORMER &amp; LLM INTERNALS. General foundational reference: how a transformer-based LLM turns text into a next-token prediction, from tokenizer to output — the mechanics underneath finzorr&#39;s model layer (Groq llama-3.3-70b chat model, nomic-embed-text embedder). See pages 15-21 for a worked-example, step-by-step walkthrough of every stage below, plus a real finzorr query traced end-to-end through the actual code." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1660" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p13_evo" value="EVOLUTION OF NLP (foundational context)&#xa;&#xa;Rules → classic ML → RNN → LSTM → GRU →&#xa;TRANSFORMER (2017, &quot;Attention Is All You Need&quot;) →&#xa;BERT / GPT-style models → RLHF-tuned chat models →&#xa;AI agents&#xa;&#xa;Why RNN/LSTM struggled: &quot;The report I read last week&#xa;was useful because IT had clear numbers.&quot; By the time&#xa;a sequential net reaches &quot;it&quot;, it has largely forgotten&#xa;&quot;report&quot; — long-range dependencies decay, and step-by-&#xa;step processing blocks GPU parallelism.&#xa;&#xa;Transformer&#39;s fix: attend to every token at once&#xa;(self-attention) → fully parallel training → scale →&#xa;modern LLMs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="380" height="270" as="geometry" />
        </mxCell>
        <mxCell id="p13_train" value="TRAINING FAMILY — what each stage adds&#xa;&#xa;PRETRAINING — next-token prediction over massive text corpora →&#xa;raw language and world-knowledge capability&#xa;&#xa;SFT (Supervised Fine-Tuning) — instruction/answer pairs teach the&#xa;base model to follow instructions&#xa;&#xa;RLHF — humans rank candidate outputs → a reward model is trained →&#xa;policy optimization (e.g. PPO) shapes helpful/harmless behavior&#xa;&#xa;DPO — direct preference optimization: a similar effect to RLHF&#xa;without training a separate reward model&#xa;&#xa;DISTILLATION — a large &quot;teacher&quot; model trains a smaller &quot;student&quot;&#xa;model, letting compact models punch above their parameter count&#xa;&#xa;A model &quot;feels&quot; capable because of scale + attention + RLHF/DPO +&#xa;instruction tuning — plus, at the application layer, whatever&#xa;retrieval, memory, and tools are layered on top of the raw model." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="380" height="280" as="geometry" />
        </mxCell>
        <mxCell id="p13_c1" value="Input text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="60" width="220" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p13_c2" value="Tokenizer&#xa;text → subword tokens, e.g. &quot;portfolio&quot; → [portfo][lio] · BPE / SentencePiece-style tokenizers · vocab ≈ 100-200k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="122" width="240" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p13_c3" value="Embedding&#xa;token → dense vector [0.32, 0.51, −0.14 … hundreds of dims]; similar meanings sit close together in vector space" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="214" width="240" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p13_c4" value="Positional Encoding&#xa;attention has no built-in sense of order — without it, &quot;stock beats bond&quot; and &quot;bond beats stock&quot; would look identical" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="306" width="240" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p13_c5" value="N × Transformer layer&#xa;Self-Attention → residual + LayerNorm → Feed-Forward → residual + LayerNorm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="392" width="240" height="62" as="geometry" />
        </mxCell>
        <mxCell id="p13_c6" value="Output layer&#xa;probability distribution over the vocabulary → next token is selected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="482" width="240" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p13_c7" value="Next token → append → repeat&#xa;decoder-only, AUTOREGRESSIVE — one token at a time (why LLM responses stream)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="562" width="240" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p13_ce1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p13_c1" target="p13_c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p13_ce2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p13_c2" target="p13_c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p13_ce3" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p13_c3" target="p13_c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p13_ce4" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p13_c4" target="p13_c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p13_ce5" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p13_c5" target="p13_c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p13_ce6" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p13_c6" target="p13_c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p13_ce7" value="loop until stop token" style="endArrow=block;html=1;dashed=1;strokeColor=#7e57c2;fontSize=10;" edge="1" parent="1" source="p13_c7" target="p13_c5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="720" y="505" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p13_attn" value="SELF-ATTENTION — the mechanism at the core of every modern LLM&#xa;&#xa;&quot;The fund missed its target because IT was too conservative.&quot;&#xa;What does &quot;it&quot; refer to? The model learns to ATTEND to &quot;fund&quot;&#xa;(not &quot;target&quot;) — token relationships are learned, not hand-coded.&#xa;&#xa;QKV — a search analogy:&#xa;Query (what I&#39;m looking for) is compared against Keys (what each&#xa;token offers) to retrieve Values (the content). &quot;risk-free rate&quot; →&#xa;Query matches a Key ≈ &quot;rate definition&quot; → Value ≈ the relevant span.&#xa;&#xa;Formula (understand it, no need to derive it):&#xa;Attention(Q,K,V) = softmax(QKᵀ / √dk) · V&#xa;• Q·Kᵀ = relevance score between every pair of tokens&#xa;• ÷ √dk = keeps the scores numerically stable&#xa;• softmax = turns scores into probabilities&#xa;• · V = weighted blend = the contextual representation&#xa;&#xa;MULTI-HEAD ATTENTION: each head is a different &quot;view&quot; of the&#xa;sequence; many heads run in parallel, learning grammar,&#xa;coreference, and semantics simultaneously.&#xa;&#xa;FFN + RESIDUALS + LAYERNORM: a per-token nonlinear transform;&#xa;residual connections keep gradients flowing in deep stacks;&#xa;LayerNorm keeps training numerically stable.&#xa;&#xa;Decoder-only models — e.g. finzorr&#39;s chat model, Groq&#xa;llama-3.3-70b — use CAUSAL attention: each token may only&#xa;attend to itself and earlier tokens, which is exactly what makes&#xa;left-to-right generation and token streaming possible." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="60" width="440" height="560" as="geometry" />
        </mxCell>
        <mxCell id="p13_adv" value="ADVANCED CONCEPTS&#xa;&#xa;KV CACHE — during generation, the keys/values already computed for&#xa;past tokens are cached, so each new token only computes attention&#xa;against the cache instead of recomputing the whole sequence. This is&#xa;why long conversations get slower per-token, and why providers that&#xa;bill for a reused prompt prefix charge less (reused prefix = reused&#xa;KV cache).&#xa;&#xa;MIXTURE OF EXPERTS (MoE) — a router activates only a handful of&#xa;expert feed-forward blocks per token instead of the whole network:&#xa;large total capacity, small per-token compute cost.&#xa;&#xa;QUANTIZATION — storing weights in fewer bits (fp16 → int8/int4)&#xa;shrinks a model and speeds up inference at a small quality cost —&#xa;the general technique that makes large models runnable on modest&#xa;hardware.&#xa;&#xa;SPECULATIVE DECODING — a small &quot;draft&quot; model proposes several&#xa;tokens ahead and a larger model verifies them in one pass — often&#xa;2-3× faster with output identical to running the large model alone.&#xa;&#xa;CONTEXT WINDOW — self-attention cost grows roughly with the square&#xa;of sequence length (O(n²)), so context-window limits are ultimately&#xa;compute limits. The practical app-layer answer is to retrieve&#xa;relevant context on demand rather than carry full history.&#xa;&#xa;CHAIN OF THOUGHT — prompting a model to &quot;think step by step&quot; (or&#xa;training reasoning in directly) produces intermediate reasoning&#xa;tokens before the final answer, generally improving multi-step&#xa;accuracy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="60" width="490" height="560" as="geometry" />
        </mxCell>
        <mxCell id="p13_faq" value="QUICK-REFERENCE Q&amp;A&#xa;&#xa;Why tokenize? Vocabulary stays manageable — tens of thousands of&#xa;learned subword tokens instead of millions of whole words; subwords&#xa;let the model handle words it has never seen as pieces (e.g.&#xa;&quot;underwriting&quot; → &quot;under&quot;+&quot;writ&quot;+&quot;ing&quot;).&#xa;&#xa;Token vs embedding? A token is a discrete unit of text (an ID). An&#xa;embedding is that token&#39;s numeric vector representation, carrying&#xa;learned meaning.&#xa;&#xa;Why positional encoding? Self-attention has no built-in sense of&#xa;order; positional information is what lets a model tell &quot;X beats Y&quot;&#xa;apart from &quot;Y beats X&quot;.&#xa;&#xa;Encoder vs decoder? BERT-style models are ENCODERS — bidirectional,&#xa;built for understanding/representation, typically used to produce&#xa;embeddings. finzorr&#39;s local embedder, nomic-embed-text, is exactly&#xa;this: a BERT-style bidirectional encoder producing the dense vectors&#xa;behind finzorr&#39;s RAG retrieval and memory search — not generating&#xa;text. GPT-style models are DECODER-ONLY — causal, autoregressive,&#xa;built for generation. finzorr&#39;s primary chat model, Groq&#xa;llama-3.3-70b, is exactly this: a standard decoder-only&#xa;causal-attention transformer. Same underlying attention mechanism,&#xa;genuinely different architecture serving a different job.&#xa;&#xa;THE GENERAL SCRIPT — how does an LLM turn a prompt into an answer?&#xa;1 prompt text → 2 tokenized → 3 embedded → 4 positional encoding&#xa;added → 5 N× (self-attention + feed-forward) layers → 6 decoder&#xa;predicts the next token → 7 repeat until a stop token → tokens decode&#xa;back to text → 8 the application layer (retrieval, memory, tools,&#xa;guardrails) wraps that raw text into the actual product response." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="650" width="760" height="460" as="geometry" />
        </mxCell>
        <mxCell id="p13_conn" value="WHY THIS MATTERS AT THE APPLICATION LAYER&#xa;&#xa;Autoregressive decoding → why LLM responses stream token-by-token&#xa;instead of arriving all at once.&#xa;&#xa;KV cache → why prompt-prefix order affects latency, and why a reused&#xa;prefix costs less.&#xa;&#xa;Context window is O(n²) → why retrieving relevant context (RAG)&#xa;beats stuffing full history into every prompt — this is exactly what&#xa;nomic-embed-text&#39;s embeddings enable for finzorr&#39;s RAG and memory.&#xa;&#xa;The model itself is stateless between calls → why conversation&#xa;memory has to live at the application layer, not inside the model.&#xa;&#xa;Next-token prediction is a statistical guess, not a lookup → the&#xa;root cause of hallucination, and why grounding/citations matter.&#xa;&#xa;Encoder vs decoder is a real architecture choice, not just a label →&#xa;finzorr pairs a decoder-only chat model (Groq llama-3.3-70b) for&#xa;conversation with a separate bidirectional encoder (nomic-embed-text)&#xa;for embeddings — matching architecture to job rather than one model&#xa;doing both." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1240" y="650" width="450" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p13_legend" value="LEGEND (standard color key used across this atlas)&#xa;&#xa;Teal = input / entry / user-facing&#xa;Blue = process / service / reference panel&#xa;Green = LIVE — actually built &amp; running in finzorr today&#xa;Amber (dashed) = PLANNED — identified gap, not yet built&#xa;Yellow = decision point / routing logic&#xa;Purple = output / synthesis / streamed result&#xa;Gray = dense reference / annotation panel&#xa;Red = risk / warning / incident&#xa;&#xa;On THIS page: teal/blue/yellow/purple mark the conceptual transformer&#xa;pipeline; gray marks dense reference panels. No green/amber/red is used&#xa;— this page is general LLM-internals reference material, not an&#xa;architecture or build-status page. The two explicit finzorr facts (Groq&#xa;llama-3.3-70b as finzorr&#39;s decoder-only chat model; nomic-embed-text as&#xa;finzorr&#39;s bidirectional embedder for RAG &amp; memory) are called out in&#xa;text rather than color-coded." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1130" width="1650" height="240" as="geometry" />
        </mxCell>

        <mxCell id="p13_ex_t" value="EASY WORKED EXAMPLE — ONE REAL FINZORR QUESTION, TRACED THROUGH THIS PAGE&#39;S PIPELINE. Reuses the exact numbers already worked out on pages 15/16/18 — nothing new invented here." style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="1390" width="1640" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p13_ex_1" value="1 · Input text&#xa;&#xa;&quot;TCS P/E ratio is high&quot;&#xa;&#xa;(page 15&#39;s running example)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1430" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p13_ex_2" value="2 · Tokenizer&#xa;&#xa;[TCS][ P][/][E][ ratio][ is][ high]&#xa;&#xa;7 tokens (page 15)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="1430" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p13_ex_3" value="3 · Embedding&#xa;&#xa;last token &quot; high&quot; →&#xa;[0.12,-0.45,0.88,0.03,0.61]&#xa;&#xa;(page 15)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="580" y="1430" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p13_ex_4" value="4 · N × Transformer layers&#xa;&#xa;Self-attention lets &quot;high&quot; exchange context with &quot;ratio&quot;/&quot;P/E&quot; — see page 16 for the hand-worked arithmetic on a comparable sentence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="850" y="1430" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p13_ex_5" value="5 · Decoder scores candidates&#xa;&#xa;Prompt &quot;TCS P/E ratio is ___&quot;&#xa;raw scores z=[2.1,1.8,1.1,0.4,-5.0]&#xa;&#xa;(page 18)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1430" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p13_ex_6" value="6 · Softmax → next token&#xa;&#xa;Highest-probability candidate sampled: &quot;high&quot;&#xa;&#xa;(page 18)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1430" width="250" height="150" as="geometry" />
        </mxCell>

        <mxCell id="p13_ex_e1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p13_ex_1" target="p13_ex_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p13_ex_e2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p13_ex_2" target="p13_ex_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p13_ex_e3" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p13_ex_3" target="p13_ex_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p13_ex_e4" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p13_ex_4" target="p13_ex_5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p13_ex_e5" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p13_ex_5" target="p13_ex_6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p14" name="14 · Operations and Design Playbook">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p14_t" value="OPERATIONS AND DESIGN PLAYBOOK — the design-answer order, real trade-off verdicts, and 4 real production incidents from building and operating finzorr.ai. Every claim below is grounded in what was actually shipped, not a generic answer." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1660" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p14_order" value="THE DESIGN-ANSWER ORDER (a durable mental model)&#xa;&#xa;Requirements → Architecture → Request Flow →&#xa;Model Selection → RAG → Agents → Evaluation →&#xa;Monitoring → Deployment&#xa;&#xa;Use this order to explain OR extend this system:&#xa;start from what it must do, then how a request&#xa;physically moves through it, then which model tier&#xa;answers, then what grounds that answer, then which&#xa;agent acts, then how correctness gets checked, then&#xa;how health is observed once live, then how a change&#xa;actually reaches production. Reasoning about model&#xa;choice before requirements is the most common way&#xa;to get this system&#39;s design wrong." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="550" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p14_trade" value="TRADE-OFF VERDICTS (finzorr&#39;s real choices — not the generic answer)&#xa;&#xa;LOCAL vs CLOUD LLM — this build&#39;s real choice: Groq (cloud, free-tier) is primary for frontier-quality&#xa;reasoning, since a 70B-class model cannot run on the production VM. Local Ollama is emergency-only&#xa;fallback. A $0-cost policy ruled out paid cloud tiers as the default — this is a budget-forced choice,&#xa;not the textbook &quot;local for privacy&quot; trade-off.&#xa;&#xa;RAG vs FINE-TUNING — this build&#39;s real choice: RAG only, for document Q&amp;A and the fundamentals&#xa;screener. Fresh data, per-document deletion supporting right-to-erasure, and citations were all&#xa;requirements fine-tuning cannot satisfy — fine-tuning was never actually in the running here.&#xa;&#xa;ONE BIG MODEL vs ROUTER + SMALL MODELS — this build&#39;s real choice: a single-model-per-tier chain,&#xa;not a query-complexity router. Traffic volume did not yet justify the routing-accuracy monitoring&#xa;overhead a router would add — a volume-gated decision, not a permanent architectural stance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="60" width="1080" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p14_inc1" value="1. CHECKPOINTER CROSS-WORKER DEADLOCK&#xa;&#xa;S — Every chat turn silently hung on &quot;Thinking&quot; forever, with no error surfaced anywhere.&#xa;&#xa;T — Diagnose and fix without further downtime.&#xa;&#xa;A — Root-caused to an asyncio Lock providing zero protection across separate --workers 2 OS&#xa;processes, plus a CREATE INDEX CONCURRENTLY step requiring autocommit=True that was missing.&#xa;Moved index setup to a genuine one-off single-process step run before workers start, and wrote a&#xa;dedicated recovery script for servers already stuck in the bad state.&#xa;&#xa;R — Verified via a live smoke test (send a message, confirm a real reply). Documented as a&#xa;generalizable lesson: any multi-worker setup logic needs process-safe coordination, not an&#xa;in-process lock." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="800" height="380" as="geometry" />
        </mxCell>
        <mxCell id="p14_inc2" value="2. FIRST PRODUCTION BUILD FAILED ON DISK SPACE&#xa;&#xa;S — The very first real image-build attempt on the OVH server failed outright.&#xa;&#xa;T — Unblock launch without just provisioning more disk.&#xa;&#xa;A — Investigated rather than reflexively adding disk. Found the build was installing a full C&#xa;compiler toolchain (build-essential, ~336MB) that was never actually needed, since every real&#xa;dependency ships pre-built wheels. Removed it.&#xa;&#xa;R — Build succeeded, and the image also became meaningfully smaller — the root cause was&#xa;fixed, not just worked around." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="380" width="800" height="380" as="geometry" />
        </mxCell>
        <mxCell id="p14_inc3" value="3. SILENT CI/CD PIPELINE BREAK, FOUND WHILE SHIPPING TWO REAL FIXES&#xa;&#xa;S — Needed to ship a data-loss fix (uploads volume) and a feature (OCR fallback) to production;&#xa;the deploy pipeline&#39;s build step failed both times with a Docker cache-driver error.&#xa;&#xa;T — Unblock both fixes without shipping a workaround.&#xa;&#xa;A — Diagnosed that the default buildx driver silently did not support the configured cache&#xa;backend — a pre-existing bug, unrelated to either fix, that had apparently been broken for a&#xa;while. Added the correct buildx setup step.&#xa;&#xa;R — Both fixes shipped in the same session; the pipeline itself came out more robust than&#xa;before the incident." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="800" height="380" as="geometry" />
        </mxCell>
        <mxCell id="p14_inc4" value="4. SELF-HOSTED DEPLOY RUNNER WENT DARK MID-SESSION, ZERO ERROR SIGNAL&#xa;&#xa;S — Discovered, while trying to ship the fixes above, that the automated CD pipeline runner&#xa;was not registered at all — a queued deploy job shows nothing wrong in the GitHub UI, it just&#xa;waits forever.&#xa;&#xa;T — Ship the urgent fixes anyway, without pretending the automation was healthy.&#xa;&#xa;A — Used a documented emergency manual-deploy procedure directly on the server instead of&#xa;waiting on a job that would never run. Flagged the gap honestly in the deployment runbook&#xa;rather than silently working around it and moving on.&#xa;&#xa;R — Both fixes shipped and verified live; the runbook now has a concrete one-line health-check&#xa;command against the GitHub API runners endpoint, so this failure mode is never silently&#xa;invisible again." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="780" width="800" height="380" as="geometry" />
        </mxCell>
        <mxCell id="p14_red" value="RED FLAGS / LESSONS (this project&#39;s own real experience)&#xa;&#xa;✗ Trusting a script works because it reads correctly is not enough — the emergency recovery&#xa;script itself shipped with two bugs of its own, found only by actually running it against a real server.&#xa;&#xa;✗ Assuming CI/CD infrastructure still works just because it did once is risky — it silently broke&#xa;and only surfaced when two real deploys needed it back to back.&#xa;&#xa;✗ Documenting something as done without re-verifying is a real risk — this project&#39;s own&#xa;deployment doc audit found real gaps between what was claimed and what was actually built,&#xa;e.g. an implied automated backup that was never built, twice." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1180" width="1000" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p14_legend" value="LEGEND&#xa;&#xa;Teal = input / entry / user-facing&#xa;Blue = process / service / reference panel&#xa;Green = LIVE — actually built and running in finzorr today&#xa;Amber dashed = PLANNED / identified gap, not yet built&#xa;Yellow = decision point / routing logic&#xa;Purple = output / synthesis / streamed result&#xa;Gray = dense reference / annotation panel&#xa;Red = risk / warning / real incident&#xa;&#xa;This page uses blue for durable reference panels, gray&#xa;for dense trade-off text, and red for real incidents and&#xa;hard-won lessons — no box here is amber or green, since&#xa;this page describes process, not a system&#39;s build status." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="1180" width="630" height="220" as="geometry" />
        </mxCell>

        <mxCell id="p14_ex_t" value="EASY WORKED EXAMPLE — ONE REAL INCIDENT, AS A SYMPTOM → FIX CHAIN. Incident #1 above (the checkpointer deadlock), same real facts, laid out as one quick scan instead of an S/T/A/R paragraph." style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="1420" width="1640" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p14_ex_1" value="1 · Symptom reported&#xa;&#xa;Every chat turn hangs on &quot;Thinking&quot; forever — no error surfaced anywhere" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1460" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p14_ex_2" value="2 · Investigation&#xa;&#xa;Traced to the checkpointer setup step, running under --workers 2 (two separate OS processes, not threads)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="355" y="1460" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p14_ex_3" value="3 · Root cause&#xa;&#xa;An asyncio.Lock gives ZERO protection across separate OS processes; CREATE INDEX CONCURRENTLY needs autocommit=True, which was missing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="670" y="1460" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p14_ex_4" value="4 · Fix applied&#xa;&#xa;Moved index setup to a genuine one-off single-process step run before workers start; wrote a recovery script for servers already stuck" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="985" y="1460" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p14_ex_5" value="5 · Verified&#xa;&#xa;Live smoke test — send a message, confirm a real reply. Documented as a generalizable lesson for any multi-worker setup step." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1300" y="1460" width="300" height="170" as="geometry" />
        </mxCell>

        <mxCell id="p14_ex_e1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p14_ex_1" target="p14_ex_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p14_ex_e2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p14_ex_2" target="p14_ex_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p14_ex_e3" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p14_ex_3" target="p14_ex_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p14_ex_e4" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p14_ex_4" target="p14_ex_5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p15" name="15 · Tokenization &amp; Embeddings — Worked Example">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1380" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p15_t" value="TOKENIZATION &amp; EMBEDDINGS — A WORKED EXAMPLE. Deep-dive companion to page 13: follows one real finzorr-style sentence, &quot;TCS P/E ratio is high&quot;, step by step from raw text to the number-vectors that power finzorr&#39;s RAG retrieval." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1660" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p15_intro" value="WHAT THIS PAGE SHOWS&#xa;&#xa;Page 13 introduced tokenization and embeddings as two boxes inside a general pipeline. This page slows down and walks through both, step by step, using one real finzorr-style sentence — &quot;TCS P/E ratio is high&quot; — with actual illustrative numbers, so the mechanism is concrete rather than abstract. Steps 1-2 are the general mechanism (how any transformer-based model turns text into numbers). Steps 3-4 show why that mechanism is useful, ending with exactly how finzorr&#39;s own retrieval (RAG) depends on it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1650" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p15_h1" value="STEP 1 — TOKENIZATION: breaking text into subword pieces the model already has in its fixed vocabulary" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="134" width="900" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p15_s1_input" value="Input text&#xa;&#xa;&quot;TCS P/E ratio is high&quot;&#xa;&#xa;A plain sentence — the kind of thing a finzorr user might type, or a line inside an uploaded document." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="156" width="250" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p15_s1_tok" value="Tokenizer&#xa;&#xa;Plain language: chops text into small chunks (&quot;tokens&quot;) drawn from a FIXED vocabulary the model was trained on.&#xa;&#xa;Common short words often stay whole. Longer, rarer, or made-up words get split into smaller pieces. Punctuation like &quot;/&quot; usually becomes its own token." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="156" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p15_s1_out" value="Tokens produced&#xa;(illustrative — approximate, not byte-exact to any one real tokenizer)&#xa;&#xa;[TCS]  [ P]  [/]  [E]  [ ratio]  [ is]  [ high]&#xa;&#xa;7 tokens from 5 words. The leading space before &quot;ratio&quot;, &quot;is&quot;, &quot;high&quot; marks &quot;a new word starts here&quot; — a real convention many tokenizers use. &quot;P/E&quot; alone splits into 3 pieces because &quot;/&quot; gets its own token." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="630" y="156" width="350" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p15_why_sub" value="WHY SUBWORDS, NOT WHOLE WORDS?&#xa;&#xa;A fixed whole-word vocabulary would need millions of entries to cover every possible word, name, and typo — and would still fail completely on any brand-new word it has never seen before.&#xa;&#xa;Subword pieces fix this: a model that has never once seen the whole word &quot;underwriting&quot; can still handle it by combining pieces it HAS seen many times elsewhere — &quot;under&quot; + &quot;writ&quot; + &quot;ing&quot;.&#xa;&#xa;Tens of thousands of subword pieces can reconstruct virtually any word, including company tickers, financial jargon, and typos — which is exactly why &quot;TCS&quot; survives as one whole token above (common enough to earn its own piece) while &quot;P/E&quot; gets split into three." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="156" width="690" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p15_s1_e1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p15_s1_input" target="p15_s1_tok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p15_s1_e2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p15_s1_tok" target="p15_s1_out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p15_h2" value="STEP 2 — EMBEDDINGS: turning each token into a list of numbers that captures meaning" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="364" width="900" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p15_s2_token" value="Take one token&#xa;&#xa;&quot; high&quot;&#xa;&#xa;(the last token from the sentence tokenized above)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p15_s2_embed" value="Embedding&#xa;&#xa;Plain language: a trained neural network converts the token into a fixed-length list of numbers (a &quot;vector&quot;).&#xa;&#xa;Every token in the vocabulary has its own learned vector — computed once during training, then looked up." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="260" y="390" width="280" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p15_s2_vec" value="Embedding vector for &quot; high&quot;&#xa;(illustrative example — real models use hundreds of numbers per token; 5 shown here for readability)&#xa;&#xa;[0.12, -0.45, 0.88, 0.03, 0.61]&#xa;&#xa;No single number &quot;means&quot; anything alone — the PATTERN across all of them encodes meaning." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="390" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p15_sim_meaning" value="SIMILAR MEANING → SIMILAR NUMBERS&#xa;&#xa;Tokens with similar meaning end up with similar number-lists, because the model was trained so that words used in similar contexts get pulled toward similar vectors.&#xa;&#xa;&quot;high&quot; and &quot;elevated&quot; would sit close together in this number-space, because both describe a value being above normal — they get used the same way across huge amounts of training text.&#xa;&#xa;&quot;high&quot; and &quot;banana&quot; would sit far apart — nothing about them is ever used the same way. Worked out with real numbers in Step 3 below." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="390" width="690" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p15_s2_e1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p15_s2_token" target="p15_s2_embed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p15_s2_e2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p15_s2_embed" target="p15_s2_vec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p15_h3" value="STEP 3 — CONCRETE EXAMPLE: measuring &quot;closeness&quot; between vectors" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="578" width="900" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p15_s3" value="MEASURING &quot;CLOSENESS&quot; — ONE SIMPLE WAY TO THINK ABOUT IT&#xa;&#xa;Add up how much two vectors differ, position by position — the smaller the total, the closer the meaning. (Real embedding models use a more refined version of this idea, called cosine similarity, but the arithmetic intuition is the same.)&#xa;&#xa;Toy example first, small numbers: if X = [2, 1] and Y = [1, 3], the difference is |2-1| + |1-3| = 1 + 2 = 3.&#xa;&#xa;Now the same idea applied to illustrative embedding vectors (5 numbers each, made-up-but-plausible):&#xa;&#xa;&quot;high&quot;      = [0.12, -0.45, 0.88, 0.03, 0.61]&#xa;&quot;elevated&quot;  = [0.15, -0.42, 0.85, 0.05, 0.58]   → position differences ≈ [0.03, 0.03, 0.03, 0.02, 0.03] → total ≈ 0.14 → CLOSE&#xa;&quot;banana&quot;    = [-0.77, 0.30, -0.10, 0.92, -0.55]  → position differences ≈ [0.89, 0.75, 0.98, 0.89, 1.16] → total ≈ 4.67 → FAR&#xa;&#xa;&quot;high&quot; and &quot;elevated&quot; land close together because the model saw them used the same way across huge amounts of text (both describe a value being above normal). &quot;banana&quot; was never used that way, so it landed somewhere else entirely — nothing about the letters in the word matters, only how it was used." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="604" width="1650" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p15_h4" value="STEP 4 — FINZORR TIE-IN (LIVE): this exact mechanism powers finzorr&#39;s document retrieval (RAG), for every chunk and every question" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="872" width="1100" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p15_s4_doc" value="User uploads a document&#xa;&#xa;e.g. an annual report PDF discussing TCS&#39;s valuation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="898" width="397" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p15_s4_chunk" value="app/documents/ingest.py&#xa;&#xa;splits the document into chunks (paragraphs / sections)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="457" y="898" width="397" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p15_s4_embed" value="nomic-embed-text&#xa;&#xa;embeds EVERY chunk — exactly the Step 1→2 mechanism above, run once per chunk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="874" y="898" width="397" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p15_s4_store" value="app/infrastructure/vector_store.py&#xa;&#xa;stores each chunk&#39;s vector in Qdrant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1291" y="898" width="397" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p15_s4_e1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p15_s4_doc" target="p15_s4_chunk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p15_s4_e2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p15_s4_chunk" target="p15_s4_embed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p15_s4_e3" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p15_s4_embed" target="p15_s4_store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p15_s4_q" value="User asks a question&#xa;&#xa;e.g. &quot;Is TCS expensive right now?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="986" width="397" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p15_s4_qembed" value="nomic-embed-text&#xa;&#xa;embeds the question the same way, into the same number-space" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="457" y="986" width="397" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p15_s4_compare" value="vector_store.py&#xa;&#xa;finds stored chunk-vectors numerically CLOSEST to the question&#39;s vector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="874" y="986" width="397" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p15_s4_result" value="Closest chunks retrieved&#xa;&#xa;passed to app/specialists/rag.py to build the grounded answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1291" y="986" width="397" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p15_s4_e4" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p15_s4_q" target="p15_s4_qembed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p15_s4_e5" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p15_s4_qembed" target="p15_s4_compare">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p15_s4_e6" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p15_s4_compare" target="p15_s4_result">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p15_s4_e7" value="stored vectors are compared against" style="endArrow=block;html=1;dashed=1;strokeColor=#34a853;fontSize=10;" edge="1" parent="1" source="p15_s4_store" target="p15_s4_compare">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1489" y="982" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p15_why_matters" value="WHY THIS MATTERS — MEANING-BASED RETRIEVAL, NOT KEYWORD MATCH&#xa;&#xa;The question above never contains the words &quot;P/E ratio&quot; — yet retrieval can still surface a document chunk about P/E ratios, because closeness is measured in the number-space (Step 3), not by matching exact words. &quot;Is TCS expensive right now?&quot; and a chunk saying &quot;TCS P/E ratio is high&quot; land near each other in vector-space because both are, in meaning, about the same thing — a valuation being elevated. This is the core reason RAG keeps working even when a user&#39;s phrasing differs from the source document&#39;s phrasing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1074" width="1650" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p15_legend" value="LEGEND (standard color key used across this atlas)&#xa;&#xa;Teal = input / entry — raw text a user typed, or a document / question as it enters the pipeline&#xa;Blue = process step — the general tokenization/embedding mechanism (applies to any transformer-based model)&#xa;Yellow = key computation step — where &quot;closeness&quot; between vectors is actually calculated&#xa;Purple = output / result — the vector, or the retrieved chunks, a step produces&#xa;Green = LIVE — actually built and running in finzorr today (app/documents/ingest.py, nomic-embed-text, app/infrastructure/vector_store.py, app/specialists/rag.py)&#xa;Gray = dense reference / annotation panel&#xa;&#xa;On THIS page: no amber (planned/not-built) and no red (risk/warning) are used — every mechanism shown here, including the finzorr tie-in in Step 4, is already live in production. This page is a worked-example companion to page 13 (general transformer/LLM internals reference)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1192" width="1650" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p16" name="16 · Positional Encoding &amp; Self-Attention — Worked Example">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p16_t" value="POSITIONAL ENCODING &amp; SELF-ATTENTION — A WORKED EXAMPLE. Deep-dive companion to page 13: how position gets encoded into a token&#39;s vector, then a fully hand-worked toy computation showing exactly how self-attention blends information across tokens — anchored to finzorr&#39;s chat model, Groq llama-3.3-70b." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1660" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p16_pos" value="POSITIONAL ENCODING — plain language first&#xa;&#xa;Self-attention on its own has NO built-in sense of word order — it just looks at a set of tokens and how they relate to each other, like a bag of words. Without extra help, &quot;stock beats bond&quot; and &quot;bond beats stock&quot; would look like the exact same bag of words to the attention math.&#xa;&#xa;The fix: positional encoding adds a small signal to each token&#39;s vector that encodes ITS POSITION in the sentence — 1st word, 2nd word, 3rd word, and so on. That position signal rides along inside the same vector as the token&#39;s meaning, so the model can tell &quot;X beats Y&quot; apart from &quot;Y beats X&quot;.&#xa;&#xa;Where this sits in the pipeline (see page 13): Input text → Tokenizer → Embedding → POSITIONAL ENCODING (this step) → N × Transformer layers (self-attention, worked out below) → Output.&#xa;&#xa;Concretely: the token embeddings for &quot;stock&quot;, &quot;beats&quot;, &quot;bond&quot; are IDENTICAL whichever order they appear in — only the added positional signal (position 1 vs. position 3) lets the model tell the two sentences apart." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="530" height="280" as="geometry" />
        </mxCell>
        <mxCell id="p16_qkv" value="QUERY / KEY / VALUE — the search analogy, plain language&#xa;&#xa;Every token produces three small vectors, each with a different job:&#xa;&#xa;QUERY (&quot;what am I looking for?&quot;) — this token&#39;s request: what other information in the sentence would help me pin down my own meaning?&#xa;&#xa;KEY (&quot;what does each other word offer?&quot;) — a label every token attaches to itself, advertising the kind of information it holds.&#xa;&#xa;VALUE (&quot;the actual content to blend in&quot;) — the real substance a token contributes IF another token&#39;s Query matches its Key well.&#xa;&#xa;Same search analogy as page 13: a Query is compared against every Key to score relevance, and those scores decide how much of each token&#39;s Value gets pulled into the result — like a search engine matching a query against document keys, then blending in the matching documents&#39; content. This exact QKV math runs inside Groq llama-3.3-70b&#39;s attention layers on every chat message, and inside nomic-embed-text&#39;s attention layers when it embeds document chunks for finzorr&#39;s RAG." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="60" width="530" height="280" as="geometry" />
        </mxCell>
        <mxCell id="p16_causal" value="CAUSAL ATTENTION — why finzorr&#39;s chat model uses it&#xa;&#xa;finzorr&#39;s chat model, Groq llama-3.3-70b, is decoder-only, which means it uses CAUSAL (a.k.a. masked) self-attention: each token may only attend to ITSELF and EARLIER tokens — never to tokens that come after it.&#xa;&#xa;Why: generation happens left-to-right, one token at a time. While the model is producing token 5, tokens 6, 7, 8... don&#39;t exist yet — there is nothing later to attend to. Causal masking enforces that reality inside the math (later positions are masked out before softmax, forced to weight ≈ 0).&#xa;&#xa;This is exactly what makes streaming possible: because each token&#39;s attention never depends on future tokens, the model can emit token 1, then compute token 2 from only tokens 1-2, then token 3 from only tokens 1-3, and so on. That is why a finzorr chat reply appears token-by-token in the UI — app/orchestration/streaming.py relays each token over the WebSocket as it&#39;s produced — instead of popping in all at once. The API call itself runs through finzorr&#39;s app/infrastructure/llm/ provider layer (OpenAICompatibleProvider) calling Groq.&#xa;&#xa;Contrast: nomic-embed-text (finzorr&#39;s embedder) is bidirectional — it deliberately looks both backward AND forward across a full chunk of text to build the best embedding, since it never generates token-by-token." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1140" y="60" width="540" height="280" as="geometry" />
        </mxCell>
        <mxCell id="p16_toy" value="TOY WORKED EXAMPLE — SETUP (illustrative numbers only, NOT a real model&#39;s weights)&#xa;&#xa;Sentence: &quot;The fund was too conservative&quot; → simplified to 3 tokens for this example: fund, was, conservative.&#xa;&#xa;Toy Query / Key / Value vectors — 2 numbers each, small on purpose so the arithmetic below is easy to follow by hand:&#xa;&#xa;fund:  Q = [1, 0]   K = [1, 0]   V = [0.9, 0.1]&#xa;was:   K = [0, 1]   V = [0.2, 0.8]&#xa;conservative:  K = [0.8, 0.2]   V = [0.6, 0.7]&#xa;&#xa;We only need fund&#39;s Query below, because we&#39;re walking through the computation for &quot;fund&quot; attending to every token in the sentence, including itself. In a real model every token gets its own Q, K, and V, and this same computation runs for all of them in parallel." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="1640" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p16_dot" value="STEP 1 — Q·K: how relevant is each token to &quot;fund&quot;?&#xa;&#xa;Take fund&#39;s Query, Q_fund = [1, 0], and dot it against every token&#39;s Key — multiply matching positions, then add:&#xa;&#xa;fund → fund:  (1×1) + (0×0) = 1.0&#xa;fund → was:  (1×0) + (0×1) = 0.0&#xa;fund → conservative:  (1×0.8) + (0×0.2) = 0.8&#xa;&#xa;Raw attention scores for &quot;fund&quot;: [1.0, 0.0, 0.8] — three different numbers. A higher score means a more relevant Key. Here &quot;fund&quot; matches itself best (1.0), &quot;conservative&quot; fairly well (0.8), and &quot;was&quot; barely at all (0.0) — which lines up with intuition: a word is most anchored to itself, but a nearby descriptive word can matter almost as much." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="790" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p16_softmax" value="STEP 2 — softmax: raw scores → a probability distribution&#xa;&#xa;Raw scores [1.0, 0.0, 0.8] aren&#39;t usable weights yet — they don&#39;t sum to 1. Softmax fixes that: exponentiate each score, then divide by the sum of all the exponentials.&#xa;&#xa;e^1.0 = 2.72   e^0.0 = 1.00   e^0.8 = 2.23&#xa;sum = 2.72 + 1.00 + 2.23 = 5.94&#xa;&#xa;weight(fund) = 2.72 / 5.94 ≈ 0.46&#xa;weight(was) = 1.00 / 5.94 ≈ 0.17&#xa;weight(conservative) = 2.23 / 5.94 ≈ 0.37&#xa;&#xa;Attention weights for &quot;fund&quot;: [0.46, 0.17, 0.37] — now summing to 1.00. The mechanic that matters: the BIGGER the raw score, the bigger the resulting weight. &quot;fund&quot; ends up paying 46% attention to itself, 37% to &quot;conservative&quot;, and only 17% to &quot;was&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="570" width="830" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p16_blend" value="STEP 3 — the weighted blend: fund&#39;s new, context-aware representation&#xa;&#xa;&quot;fund&quot;&#39;s final representation isn&#39;t its old Value alone — it&#39;s a WEIGHTED BLEND of every token&#39;s Value vector, weighted by the attention weights just computed:&#xa;&#xa;new_fund = 0.46×V_fund + 0.17×V_was + 0.37×V_conservative&#xa;= 0.46×[0.9,0.1] + 0.17×[0.2,0.8] + 0.37×[0.6,0.7]&#xa;= [0.414,0.046] + [0.034,0.136] + [0.222,0.259]&#xa;= [0.67, 0.44]&#xa;&#xa;Compare to the original V_fund = [0.9, 0.1] — the vector has shifted, because 37% of &quot;conservative&quot;&#39;s Value got pulled in. In plain language: after this attention step, &quot;fund&quot; isn&#39;t just &quot;fund&quot; anymore — its vector now carries a real trace of &quot;conservative&quot;, because the attention score there was high. This is how a transformer builds context: not by rewriting words, but by blending each token&#39;s vector with weighted information from the tokens around it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="790" height="320" as="geometry" />
        </mxCell>
        <mxCell id="p16_d_lbl" value="VISUALIZING STEP 3 — three tokens&#39; Values blend into fund&#39;s new representation, weighted by attention" style="text;html=1;fontSize=11;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="850" y="858" width="830" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p16_d_fund" value="fund&#xa;V = [0.9, 0.1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="890" width="230" height="68" as="geometry" />
        </mxCell>
        <mxCell id="p16_d_was" value="was&#xa;V = [0.2, 0.8]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="978" width="230" height="68" as="geometry" />
        </mxCell>
        <mxCell id="p16_d_cons" value="conservative&#xa;V = [0.6, 0.7]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="1066" width="230" height="68" as="geometry" />
        </mxCell>
        <mxCell id="p16_d_out" value="fund — context-aware&#xa;new_fund ≈ [0.67, 0.44]&#xa;46% self + 17% was + 37% conservative" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;spacingLeft=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1360" y="960" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p16_d_e1" value="weight ≈ 0.46" style="endArrow=block;html=1;strokeColor=#7e57c2;fontSize=10;" edge="1" parent="1" source="p16_d_fund" target="p16_d_out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p16_d_e2" value="weight ≈ 0.17" style="endArrow=block;html=1;strokeColor=#7e57c2;fontSize=10;" edge="1" parent="1" source="p16_d_was" target="p16_d_out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p16_d_e3" value="weight ≈ 0.37" style="endArrow=block;html=1;strokeColor=#7e57c2;fontSize=10;" edge="1" parent="1" source="p16_d_cons" target="p16_d_out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p16_legend" value="LEGEND (standard color key used across this atlas)&#xa;&#xa;Teal = input / entry — the toy sentence and toy Q/K/V vectors that seed this worked example&#xa;Blue = process / concept reference — positional encoding, the QKV analogy&#xa;Green = LIVE — actually built &amp; running in finzorr today — causal attention inside Groq llama-3.3-70b, and the token-by-token streaming it enables&#xa;Yellow = decision point / key computation step — the hand-worked Q·K dot products and softmax arithmetic&#xa;Purple = output / result — fund&#39;s final, context-blended representation&#xa;Gray = dense reference / annotation panel&#xa;&#xa;On THIS page: no amber (planned/not-built) or red (risk/warning) is used — this is a worked-example deep dive into mechanics already live in finzorr&#39;s model layer, not a build-status or risk page. Every numeric vector on this page (Q, K, V, dot-product scores, softmax weights) is a small illustrative toy number chosen to make the arithmetic easy to follow by hand — NOT a real weight or activation from finzorr&#39;s actual model (Groq llama-3.3-70b). See page 13 for the general transformer pipeline this page zooms into; this page is part of the transformer/LLM-internals deep-dive series (pages 15-21)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1190" width="1640" height="230" as="geometry" />
        </mxCell>

        <mxCell id="p16_ex_t" value="EASY WORKED EXAMPLE — THE SAME COMPUTATION, AS ONE QUICK CHAIN. Same toy sentence, same real numbers from the STEP 1-3 panels above — just laid out as one scan instead of three paragraphs." style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="1430" width="1640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p16_ex_setup" value="1 — Toy sentence &amp; Q/K/V&#xa;&#xa;&quot;fund was too conservative&quot;&#xa;fund: Q=[1,0] K=[1,0] V=[0.9,0.1]&#xa;was: K=[0,1] V=[0.2,0.8]&#xa;conservative: K=[0.8,0.2] V=[0.6,0.7]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1470" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p16_ex_dot" value="2 — Q·K dot products&#xa;&#xa;fund→fund = 1.0&#xa;fund→was = 0.0&#xa;fund→conservative = 0.8&#xa;&#xa;raw scores: [1.0, 0.0, 0.8]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="360" y="1470" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p16_ex_softmax" value="3 — Softmax&#xa;&#xa;[1.0, 0.0, 0.8]&#xa;→&#xa;[0.46, 0.17, 0.37]&#xa;&#xa;now sums to 1.00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="680" y="1470" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p16_ex_wblend" value="4 — Weighted blend&#xa;&#xa;0.46×V_fund + 0.17×V_was&#xa;+ 0.37×V_conservative" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1000" y="1470" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p16_ex_out" value="5 — New context-aware vector&#xa;&#xa;new_fund ≈ [0.67, 0.44]&#xa;&#xa;&quot;fund&quot; now carries a real trace of &quot;conservative&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1320" y="1470" width="300" height="180" as="geometry" />
        </mxCell>

        <mxCell id="p16_ex_e1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p16_ex_setup" target="p16_ex_dot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p16_ex_e2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p16_ex_dot" target="p16_ex_softmax">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p16_ex_e3" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p16_ex_softmax" target="p16_ex_wblend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p16_ex_e4" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p16_ex_wblend" target="p16_ex_out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p17" name="17 · The Transformer Block in Detail">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p17_t" value="THE TRANSFORMER BLOCK IN DETAIL — inside the &quot;N × Transformer layer&quot; box from page 13: multi-head attention, the feed-forward network, residual connections, and LayerNorm, each explained plain-language-first with a small worked example." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1660" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p17_attn" value="MULTI-HEAD ATTENTION — several attention &quot;searches&quot; at once&#xa;&#xa;Plain language: page 13 covers ONE attention computation — a Query&#xa;compared against Keys to retrieve Values. Multi-head attention runs&#xa;SEVERAL of these searches in PARALLEL. Each parallel copy is called a&#xa;HEAD, and each head can learn to focus on a different KIND of&#xa;relationship between tokens.&#xa;&#xa;Worked example — illustrative, not literally observable in any real&#xa;model:&#xa;&#xa;&quot;The fund missed its target because it was too conservative.&quot;&#xa;&#xa;• One head might learn to connect &quot;it&quot; back to &quot;fund&quot; — tracking&#xa;what a pronoun refers to (coreference)&#xa;• A different head might learn to connect &quot;missed&quot; and &quot;target&quot; —&#xa;tracking action / object relationships&#xa;• Another head might focus on financial vocabulary, linking &quot;fund&quot;&#xa;and &quot;conservative&quot;&#xa;&#xa;This shows the KIND of pattern heads tend to specialize in during&#xa;training — it is not a guarantee that any specific head in any real&#xa;model does exactly this; which head learns what is discovered&#xa;empirically after training, never hand-designed.&#xa;&#xa;Small arithmetic sketch: with, say, 8 heads and a 512-dimension token&#xa;vector, each head works on a 512 / 8 = 64-dimension slice. Each head&#xa;independently produces its own weighted blend (its own small&#xa;Attention(Q,K,V) result from page 13), then all 8 head-outputs are&#xa;concatenated back into one 512-dimension vector before the block&#xa;continues." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="800" height="480" as="geometry" />
        </mxCell>
        <mxCell id="p17_ffn" value="FEED-FORWARD NETWORK (FFN) — think alone, one token at a time&#xa;&#xa;Plain language: attention&#39;s job is to GATHER relevant context from&#xa;everywhere else in the sentence and blend it into each token&#39;s&#xa;vector. The FFN&#39;s job is different — it takes each token&#39;s (now&#xa;context-enriched) vector and processes it ENTIRELY ON ITS OWN. No&#xa;comparing across tokens, no looking at neighbors — just that one&#xa;token&#39;s numbers, transformed.&#xa;&#xa;Analogy: attention is like going around the room and collecting&#xa;notes from everyone relevant to your question. The FFN is sitting&#xa;down alone afterward and thinking through what you gathered — no&#xa;more conversation, just your own reasoning on your own notes.&#xa;&#xa;Worked example (toy numbers): say after attention the token&#xa;&quot;conservative&quot; comes out as a small vector [0.9, −0.2, 0.4] (already&#xa;blended with context borrowed from &quot;fund&quot; and &quot;target&quot;). The FFN&#xa;takes exactly that vector, independently expands it to a wider&#xa;hidden size, applies a nonlinearity, and projects it back down to&#xa;the original size — never looking at &quot;fund&quot;&#39;s or &quot;missed&quot;&#39;s vectors&#xa;again. Meanwhile the vector for &quot;fund&quot;, say [0.1, 0.6, −0.3], goes&#xa;through the IDENTICAL FFN weights but as a completely separate,&#xa;independent pass.&#xa;&#xa;finzorr angle: this per-token, weights-shared-but-computed-&#xa;independently pattern is why FFN cost scales linearly with sequence&#xa;length, unlike attention&#39;s roughly quadratic cost (page 13&#39;s&#xa;context-window note) — one more reason long conversations get&#xa;proportionally more expensive at the attention step, not the FFN&#xa;step." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="60" width="800" height="480" as="geometry" />
        </mxCell>
        <mxCell id="p17_resid" value="RESIDUAL CONNECTIONS — add, don&#39;t replace&#xa;&#xa;Plain language: at each step, a layer&#39;s output does NOT overwrite&#xa;its input. Instead: output = input + what_this_layer_computed. The&#xa;original signal survives every single layer; each layer&#39;s&#xa;contribution is added on top rather than replacing what came before.&#xa;&#xa;Analogy: like a note-taker who keeps their original notes AND adds&#xa;new annotations in the margin on each pass, rather than erasing the&#xa;page and rewriting it from scratch every time. Nothing earlier is&#xa;lost — every layer&#39;s work shows up as an addition, not a rewrite.&#xa;&#xa;Worked example (toy numbers): input vector x = [1.0, 2.0]. Suppose&#xa;this layer computes a small correction, sublayer(x) = [0.1, −0.3].&#xa;Residual output = x + sublayer(x) = [1.0+0.1, 2.0−0.3] = [1.1, 1.7]&#xa;— close to the original input, gently adjusted, not replaced.&#xa;&#xa;Why it matters: a production chat model stacks MANY of these blocks&#xa;on top of each other (finzorr&#39;s chat model, Groq llama-3.3-70b,&#xa;stacks dozens). During training, the gradient — the signal that says&#xa;how to adjust each layer&#39;s weights — has to flow backward through&#xa;every one of those stacked layers. Without residual connections that&#xa;signal tends to shrink toward zero the deeper it travels (the&#xa;classic &quot;vanishing gradient&quot; problem), making very deep stacks hard&#xa;to train well. &quot;Keep the original, add a little&quot; gives the gradient&#xa;a direct, undiluted path straight back through every block." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="800" height="420" as="geometry" />
        </mxCell>
        <mxCell id="p17_norm" value="LAYERNORM — keep every token&#39;s numbers well-behaved&#xa;&#xa;Plain language: after combining values (e.g. right after the&#xa;residual add), LayerNorm rescales the numbers inside EACH token&#39;s&#xa;vector so they sit in a consistent, well-behaved range. It looks at&#xa;one token&#39;s vector at a time — not across tokens — roughly:&#xa;subtract the mean, divide by the spread, then apply a small learned&#xa;rescale/shift.&#xa;&#xa;Analogy: like a sound engineer adjusting the volume on a mixing&#xa;board so no single input channel is way too loud or way too quiet&#xa;relative to the others. It doesn&#39;t change WHAT the signal says —&#xa;just keeps its scale consistent so downstream layers (and training&#xa;itself) behave predictably.&#xa;&#xa;Worked example (toy numbers): vector before norm = [10, 2, 4] — mean&#xa;≈ 5.3, fairly spread out. LayerNorm rescales it to roughly&#xa;[1.1, −0.65, −0.44] (mean ≈ 0, unit-ish spread), then applies a small&#xa;learned scale/shift. A &quot;stock&quot;-type token with large raw numbers and&#xa;a &quot;the&quot;-type token with tiny raw numbers both land in the same&#xa;well-behaved range before entering the next layer.&#xa;&#xa;Why it matters: stack enough layers without this rescaling and the&#xa;numbers inside each vector can drift to very large or very small&#xa;magnitudes, layer after layer. LayerNorm resets every layer to a&#xa;similar numeric baseline, which is part of what keeps deep-stack&#xa;training stable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="560" width="800" height="420" as="geometry" />
        </mxCell>
        <mxCell id="p17_diagtitle" value="THE FULL TRANSFORMER BLOCK (one layer) — steps 2-5 run in sequence; this whole block then repeats N× stacked on top of each other. Larger models simply stack more of these identical blocks." style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="1620" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p17_b1" value="1 · Input token vectors&#xa;From token + positional embeddings (first block), or the previous block&#39;s output (every later block)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1034" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p17_b2" value="2 · Self-Attention (multi-head)&#xa;Gather relevant context from other tokens — see the multi-head panel above&#xa;&#xa;e.g. one head links &quot;it&quot; → &quot;fund&quot;; another links &quot;missed&quot; ↔ &quot;target&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="316" y="1034" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p17_b3" value="3 · Add residual + LayerNorm&#xa;output = input + attention(input), then rescaled&#xa;&#xa;e.g. [1.0,2.0] + [0.1,-0.3] = [1.1,1.7] → LayerNorm-rescaled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="592" y="1034" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p17_b4" value="4 · Feed-Forward (FFN)&#xa;Each token&#39;s vector processed on its own — see the FFN panel above&#xa;&#xa;e.g. &quot;conservative&quot; = [0.9,-0.2,0.4] → expand → nonlinearity → project back, alone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="868" y="1034" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p17_b5" value="5 · Add residual + LayerNorm&#xa;output = input + FFN(input), then rescaled&#xa;&#xa;e.g. [10,2,4] (mean≈5.3) → LayerNorm → ≈[1.1,-0.65,-0.44]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1144" y="1034" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p17_b6" value="6 · Output token vectors&#xa;→ next transformer block, or → the final output layer on the last block" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1420" y="1034" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p17_be1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p17_b1" target="p17_b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p17_be2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p17_b2" target="p17_b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p17_be3" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p17_b3" target="p17_b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p17_be4" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p17_b4" target="p17_b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p17_be5" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p17_b5" target="p17_b6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p17_beloop" value="repeats N× — stacked blocks; larger models simply stack more of these" style="endArrow=block;html=1;dashed=1;strokeColor=#7e57c2;fontSize=10;" edge="1" parent="1" source="p17_b6" target="p17_b1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1550" y="1206" />
              <mxPoint x="170" y="1206" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p17_conn" value="WHY THIS MATTERS AT THE APPLICATION LAYER&#xa;&#xa;Every specialist call in finzorr — app/specialists/nl2sql.py building&#xa;a SQL-focused prompt, app/specialists/rag.py building a retrieval-&#xa;grounded prompt — ultimately becomes a token sequence that runs&#xa;through exactly this stack of blocks, inside whichever model&#xa;app/infrastructure/llm/&#39;s OpenAICompatibleProvider is pointed at&#xa;(Groq llama-3.3-70b in production; Gemini or Ollama as configured&#xa;alternatives).&#xa;&#xa;app/orchestration/supervisor.py decides WHICH specialist&#39;s prompt&#xa;gets built and sent for routing — it never touches attention heads&#xa;or FFN weights directly; those live entirely inside the model the&#xa;provider calls, outside finzorr&#39;s application code.&#xa;&#xa;app/orchestration/streaming.py relays tokens over the WS connection&#xa;as they&#39;re produced — each streamed token is the result of one more&#xa;pass through this same block stack (see page 13&#39;s autoregressive&#xa;loop).&#xa;&#xa;finzorr&#39;s embedder, nomic-embed-text (used by app/documents/ingest.py&#xa;and app/infrastructure/vector_store.py&#39;s Qdrant lookups), is built&#xa;from this same block type — self-attention + FFN + residual +&#xa;LayerNorm — just bidirectional/non-causal and tuned to produce&#xa;embeddings rather than generate text." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="1620" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p17_legend" value="LEGEND (standard color key used across this atlas)&#xa;&#xa;Teal = input / entry point into the block&#xa;Blue = process step (add residual + LayerNorm) / core-mechanism reference panel (multi-head attention)&#xa;Yellow = key computation step (self-attention, feed-forward) / key-takeaway panel&#xa;Purple = output / result of the block&#xa;Gray = dense reference / annotation panel&#xa;&#xa;On THIS page: teal marks the block&#39;s input; yellow marks the two core computation steps in the&#xa;diagram (self-attention, feed-forward) plus the &quot;why this matters&quot; takeaway panel; blue marks the&#xa;add-residual-+-LayerNorm steps in the diagram plus the multi-head-attention reference panel; purple&#xa;marks the block&#39;s output; gray marks the three supplementary explanation panels (FFN, residual&#xa;connections, LayerNorm). No green/amber/red is used — like page 13, this page is general&#xa;transformer-internals reference material, not an architecture or build-status page. The&#xa;finzorr-specific facts (Groq llama-3.3-70b as the model actually running this block stack;&#xa;nomic-embed-text built from the same block type) are called out in text rather than color-coded." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1500" width="1620" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p18" name="18 · From Layers to Output — Decoding &amp; Streaming">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1510" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p18_t" value="18 · FROM LAYERS TO OUTPUT: DECODING AND STREAMING — A WORKED EXAMPLE. How the last transformer layer&#39;s scores become one actual next word: softmax over the vocabulary, temperature-controlled sampling, the autoregressive append-and-repeat loop, and the KV cache that keeps it fast — why a finzorr reply streams in token by token." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1660" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p18_prompt" value="PROMPT SO FAR&#xa;&quot;TCS P/E ratio is ___&quot;&#xa;&#xa;The model must predict just the ONE next word." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p18_context" value="In a REAL model this &quot;output layer&quot; produces one score&#xa;for EVERY word in the vocabulary — tens of thousands of&#xa;candidates. Below is a tiny toy slice: just 5, continuing&#xa;straight from page 13&#39;s &quot;Output layer&quot; box." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="430" y="60" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p18_formula" value="SOFTMAX — turning raw scores into probabilities&#xa;&#xa;P(word_i) = e^(z_i) / Σ_j e^(z_j)&#xa;&#xa;z_i = the model&#39;s raw score (&quot;logit&quot;) for word i&#xa;e^(z_i) = exponentiate so every score is positive&#xa;÷ Σ e^(z_j) = divide by the total so all probabilities&#xa;across the WHOLE vocabulary add up to 1&#xa;&#xa;WORKED ARITHMETIC (the 5 candidates on the left):&#xa;z = [2.1, 1.8, 1.1, 0.4, -5.0]&#xa;e^z ≈ [8.17, 6.05, 3.00, 1.49, 0.0067]&#xa;Σ e^z ≈ 18.72&#xa;→ P ≈ [0.42, 0.32, 0.16, 0.08, 0.0004]&#xa;(sums to ≈ 1, as softmax guarantees)&#xa;&#xa;Highest probability wins the &quot;most likely&quot; label — exactly&#xa;why &quot;high&quot; (42%) beats &quot;banana&quot; (0.04%): the model has&#xa;essentially never seen &quot;TCS P/E ratio is banana&quot; in&#xa;training, so it scores that continuation near zero." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="850" y="60" width="350" height="360" as="geometry" />
        </mxCell>
        <mxCell id="p18_cand1" value="&quot;high&quot;&#xa;logit z = 2.1&#xa;e^z ≈ 8.17&#xa;P = 8.17 ÷ 18.72&#xa;≈ 0.42 (42%)&#xa;← top score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="145" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p18_cand2" value="&quot;low&quot;&#xa;logit z = 1.8&#xa;e^z ≈ 6.05&#xa;P ≈ 6.05 ÷ 18.72&#xa;≈ 0.32 (32%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="200" y="140" width="145" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p18_cand3" value="&quot;moderate&quot;&#xa;logit z = 1.1&#xa;e^z ≈ 3.00&#xa;P ≈ 3.00 ÷ 18.72&#xa;≈ 0.16 (16%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="140" width="145" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p18_cand4" value="&quot;volatile&quot;&#xa;logit z = 0.4&#xa;e^z ≈ 1.49&#xa;P ≈ 1.49 ÷ 18.72&#xa;≈ 0.08 (8%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="520" y="140" width="145" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p18_cand5" value="&quot;banana&quot;&#xa;logit z = -5.0&#xa;e^z ≈ 0.0067&#xa;P ≈ 0.0067 ÷ 18.72&#xa;≈ 0.0004 (0.04%)&#xa;← essentially never" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="140" width="145" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p18_chosen" value="SAMPLING — which candidate actually gets chosen&#xa;&#xa;TEMPERATURE controls how strictly the model sticks to the top score. At temperature 0 the model is deterministic: it always takes the argmax (single highest probability) — here &quot;high&quot; at 42%, so &quot;high&quot; is chosen EVERY time. At higher temperature it might occasionally sample &quot;moderate&quot; instead — see the TEMPERATURE panel →&#xa;&#xa;Chosen next word (at T = 0): &quot;high&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="795" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p18_app1" value="APPEND&#xa;&quot;TCS P/E ratio is&quot; + &quot;high&quot; →&#xa;&quot;TCS P/E ratio is high&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p18_pred2" value="PREDICT NEXT&#xa;over the new, longer sequence →&#xa;e.g. &quot;,&quot; (comma) or &quot;.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="340" y="440" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p18_app2" value="APPEND&#xa;&quot;TCS P/E ratio is high&quot; + &quot;,&quot; →&#xa;&quot;TCS P/E ratio is high,&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="590" y="440" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p18_repeat" value="... REPEAT — one word at a time&#xa;&#xa;The WHOLE sequence built so far is fed back through every transformer layer again just to predict ONE more word. Each new word is only possible because of every word that came before it — this is what &quot;autoregressive&quot; means." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p18_stop" value="&lt;STOP&gt; TOKEN&#xa;&#xa;Eventually the model predicts a special end-of-sequence token instead of a word — the signal that the response is finished." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="520" y="530" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p18_done" value="RESPONSE COMPLETE&#xa;&#xa;The full reply — built one token at a time — now sits in the conversation history." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="770" y="530" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p18_kv_explain" value="KV CACHE — plain language&#xa;&#xa;At every generation step the model runs self-attention: each token&#39;s Query is compared against the Keys of every OTHER token, then their Values are blended (page 13&#39;s QKV &quot;search&quot; analogy). But an earlier token&#39;s Key and Value never change once computed — recomputing them from scratch for EVERY earlier token, at EVERY new word, would be pure waste.&#xa;&#xa;So the model CACHES (saves) the Key and Value vectors it already computed for every earlier token. At each new step it only computes fresh Query/Key/Value for the ONE brand-new token, then reuses the cached K/V for everything before it — cheap to add one more word, no need to redo the rest." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="560" height="320" as="geometry" />
        </mxCell>
        <mxCell id="p18_kv_example" value="CONCRETE EXAMPLE — cost with vs. without the cache&#xa;&#xa;Generating the 5th word: attends back to 4 previous tokens → cheap either way, only 4 K/V pairs involved.&#xa;&#xa;Generating the 200th word: attends back to 199 previous tokens. WITHOUT a cache, that single step would have to recompute Key/Value for all 199 prior tokens from scratch — and so would every step before and after it.&#xa;&#xa;Across a full n-word response WITHOUT caching: step 1 redoes 1 token&#39;s K/V, step 2 redoes 2, step 3 redoes 3 ... step n redoes n → total work ≈ 1+2+...+n, growing roughly with n² — responses would get dramatically, visibly slower the longer they ran.&#xa;&#xa;WITH the KV cache: every step computes K/V for only the ONE new token → total new work grows roughly with n, not n². This is what keeps generating word 200 roughly as fast as word 5." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="650" width="560" height="320" as="geometry" />
        </mxCell>
        <mxCell id="p18_finzorr" value="LIVE IN FINZORR — why replies appear word-by-word, not all at once&#xa;&#xa;This exact loop — softmax over the vocabulary, temperature-scaled sampling, append, repeat, kept cheap by the KV cache — is why a finzorr reply visibly builds up token-by-token instead of popping in as one finished block.&#xa;&#xa;app/orchestration/streaming.py relays each newly-generated token over the WebSocket to the frontend the MOMENT the model produces it — it does NOT wait for the full response to finish first.&#xa;&#xa;Those tokens are produced by finzorr&#39;s primary chat model, Groq llama-3.3-70b (decoder-only, causal attention — see page 13), called through app/infrastructure/llm/&#39;s OpenAICompatibleProvider — the shared client finzorr uses to reach Groq, Gemini, or a local Ollama model. Routing that decides WHICH specialist handles the message (app/orchestration/supervisor.py — e.g. app/specialists/nl2sql.py for SQL questions, app/specialists/rag.py for document Q&amp;A) happens BEFORE this decoding loop starts; once the chosen specialist&#39;s prompt reaches the model, everything on this page is what produces each streamed word of the answer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="990" width="1140" height="250" as="geometry" />
        </mxCell>
        <mxCell id="p18_temp" value="TEMPERATURE — plain language&#xa;&#xa;One dial that controls how &quot;safe&quot; vs. how &quot;adventurous&quot; the next-word choice is. Mechanically, it divides every logit by T before softmax: P(word_i) = e^(z_i / T) / Σ_j e^(z_j / T)&#xa;&#xa;LOW temperature (T → 0): the gap between scores gets STRETCHED — the top word dominates almost completely. At T = 0 the model is deterministic: it always takes the single highest score — here, always &quot;high&quot;, every single time. Predictable, repeatable, but repetitive.&#xa;&#xa;HIGHER temperature (e.g. T = 2): the gap gets COMPRESSED. Worked example — same 5 logits [2.1, 1.8, 1.1, 0.4, -5.0], each divided by 2 = [1.05, 0.9, 0.55, 0.2, -2.5]:&#xa;e^z ≈ [2.86, 2.46, 1.73, 1.22, 0.08], Σ ≈ 8.35&#xa;→ P(&quot;high&quot;) ≈ 0.34 (34%) — down from 42% at T = 1&#xa;→ P(&quot;low&quot;) ≈ 0.29 (29%)&#xa;→ P(&quot;moderate&quot;) ≈ 0.21 (21%) — up from 16%, now a real contender instead of a distant third&#xa;→ P(&quot;volatile&quot;) ≈ 0.15 (15%)&#xa;→ P(&quot;banana&quot;) ≈ 0.01 (1%) — still nearly never picked&#xa;&#xa;So at T = 2 the model might occasionally sample &quot;moderate&quot; instead of &quot;high&quot; — more variety, still overwhelmingly sensible, essentially never nonsense like &quot;banana&quot;. Low T = predictable/repetitive. High T = more creative but riskier." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1220" y="60" width="470" height="480" as="geometry" />
        </mxCell>
        <mxCell id="p18_recap" value="QUICK RECAP — this whole page as one script&#xa;&#xa;1 last transformer layer&#39;s output → 2 the output layer produces one raw score (&quot;logit&quot;) per vocabulary word → 3 softmax turns ALL those scores into a probability distribution that sums to 1 (worked example on this page: 5 toy candidates, &quot;high&quot; wins at ≈42%) → 4 temperature reshapes that distribution before sampling — low T ≈ deterministic top pick, high T ≈ more variety → 5 one word is sampled → 6 it is APPENDED to the growing sequence → 7 the WHOLE sequence is fed through the model again to predict just the next word → 8 repeat, one word at a time, until a &lt;stop&gt; token appears → 9 the KV cache is what keeps step 7 cheap even late in a long response, by reusing cached Key/Value vectors instead of recomputing them from scratch → 10 in finzorr, each token from step 5 is streamed to the frontend over WebSocket (app/orchestration/streaming.py) the instant it&#39;s produced — which is why replies appear progressively instead of all at once.&#xa;&#xa;RELATION TO PAGE 13: page 13&#39;s &quot;Output layer&quot; and &quot;Next token → append → repeat&quot; boxes are the two steps this page zooms into with an actual worked example and real numbers, plus the two mechanics — temperature and the KV cache — that page 13&#39;s ADVANCED CONCEPTS panel only named in passing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1220" y="560" width="470" height="600" as="geometry" />
        </mxCell>
        <mxCell id="p18_legend" value="LEGEND (standard color key used across this atlas)&#xa;&#xa;Teal = input / entry — the prompt/sequence so far&#xa;Blue = process / deep-dive reference panel — softmax formula, temperature mechanics, KV cache mechanism&#xa;Yellow = decision point / key computation step — each place the model actually scores, samples, or picks a token&#xa;Purple = output / result — sampled word, append step, completed response&#xa;Gray = dense reference / annotation panel&#xa;Green = LIVE — actually built &amp; running in finzorr today&#xa;&#xa;On THIS page: teal/yellow/purple trace the worked decoding example and the autoregressive append-and-repeat loop; blue and gray panels are deep-dive reference material; green marks the one confirmed finzorr fact — app/orchestration/streaming.py relaying tokens over WebSocket as they&#39;re produced. No red (risk/warning) or amber (planned/not-built) is used — everything here is either general LLM-decoding mechanics or an already-confirmed, already-built finzorr behavior." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1270" width="1650" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p18_ef1" value="scored against entire vocabulary — 5 shown here" style="endArrow=block;html=1;dashed=1;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="p18_prompt" target="p18_cand1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p18_ef2" style="endArrow=block;html=1;dashed=1;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="p18_prompt" target="p18_cand2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p18_ef3" style="endArrow=block;html=1;dashed=1;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="p18_prompt" target="p18_cand3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p18_ef4" style="endArrow=block;html=1;dashed=1;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="p18_prompt" target="p18_cand4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p18_ef5" style="endArrow=block;html=1;dashed=1;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="p18_prompt" target="p18_cand5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p18_ewin" value="argmax @ T=0" style="endArrow=block;html=1;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="p18_cand1" target="p18_chosen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p18_ec1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p18_chosen" target="p18_app1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p18_ec2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p18_app1" target="p18_pred2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p18_ec3" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p18_pred2" target="p18_app2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p18_ec4" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p18_app2" target="p18_repeat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
