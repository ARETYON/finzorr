        </mxCell>
        <mxCell id="p3_e11" style="endArrow=block;html=1;strokeColor=#d6b656;" edge="1" parent="1" source="p3_intent" target="p3_spec5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e12" style="endArrow=block;html=1;strokeColor=#d6b656;" edge="1" parent="1" source="p3_intent" target="p3_spec6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e13" style="endArrow=block;html=1;strokeColor=#d6b656;" edge="1" parent="1" source="p3_intent" target="p3_spec7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e14" value="abstract dependency" style="endArrow=block;html=1;dashed=1;strokeColor=#6c8ebf;fontColor=#6c8ebf;fontSize=9;" edge="1" parent="1" source="p3_spec2" target="p3_infra">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e15" value="pure logic (citations, chunking, retrieval)" style="endArrow=block;html=1;dashed=1;strokeColor=#6c8ebf;fontColor=#6c8ebf;fontSize=9;" edge="1" parent="1" source="p3_spec2" target="p3_domain">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="285" y="805" />
              <mxPoint x="885" y="805" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p3_e16" style="endArrow=block;html=1;strokeColor=#34a853;" edge="1" parent="1" source="p3_infra" target="p3_llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e17" style="endArrow=block;html=1;strokeColor=#34a853;" edge="1" parent="1" source="p3_domain" target="p3_llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e18" style="endArrow=block;html=1;strokeColor=#7e57c2;" edge="1" parent="1" source="p3_llm" target="p3_stream">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e19" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p3_stream" target="p3_persist">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e20" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p3_stream" target="p3_eval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e21" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p3_stream" target="p3_ana">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_why" value="WHY AN ORCHESTRATOR? (the brain)&#xa;&#xa;LangGraph (app/orchestration/graph.py) decides, per turn:&#xa;• which specialist(s) handle each step&#xa;• whether the turn needs multi-step planning (supervisor plans 1-3 steps)&#xa;• whether steps can run in parallel&#xa;• whether human-in-the-loop (HITL) approval is required before continuing&#xa;&#xa;State is checkpointed per session (AsyncPostgresSaver, thread_id = session_id) — the graph survives an api restart mid-conversation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1210" y="60" width="480" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p3_layers" value="THE 5-LAYER BACKEND, AT A GLANCE&#xa;&#xa;1. interface — app/interface/ — routers + /ws/chat handler; thin, delegates to orchestration&#xa;2. orchestration — app/orchestration/ — graph.py (LangGraph StateGraph) + supervisor.py (routing)&#xa;3. specialists — app/specialists/ — 7 specialists behind a common Specialist Protocol (no inheritance)&#xa;4. infrastructure — app/infrastructure/ — every external adapter (db, redis, vector_store, llm/)&#xa;5. domain — app/domain/ — pure business logic (citations, pii, guard, chunking, retrieval); zero I/O&#xa;&#xa;Dependency direction: specialists → infrastructure (abstract) and specialists → domain (pure functions). Domain never talks to infrastructure directly." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1210" y="290" width="480" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p3_res" value="RESILIENCE PATTERNS (real examples, all LIVE)&#xa;&#xa;• Provider fallback chain — Groq (primary) → Gemini (fallback) → local Ollama (emergency); see page 10&#xa;• Degrade gracefully — supervisor falls back to a deterministic regex/keyword router when the routing LLM call fails&#xa;• Turn lock — Redis SET NX EX with TTL self-heal. Fixes a real past incident: an in-process lock gave zero protection once the api container ran with --workers 2 — two worker processes could both think they held the lock&#xa;• Checkpointer degradation — AsyncPostgresSaver-backed graph state has a degradation path for when the checkpoint store is unavailable&#xa;• WS reconnect backoff — the frontend reconnects /ws/chat with backoff after a drop&#xa;• NL2SQL self-correction retry — a failed generated query is retried with self-correction rather than failing the turn&#xa;• HITL interrupt-based approval parking — LangGraph interrupt() parks a step awaiting human approval; durable, survives a reload because state is checkpointed&#xa;&#xa;Interview line: &quot;every external dependency has a fallback, a degrade path, or both.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1210" y="530" width="480" height="350" as="geometry" />
        </mxCell>
        <mxCell id="p3_leg" value="LEGEND&#xa;■ teal — input / entry (user)&#xa;■ green — LIVE, actually built and running today&#xa;▢ amber dashed — PLANNED, honest gap (none on this page)&#xa;■ yellow — decision point / routing logic&#xa;■ purple — output / streamed result&#xa;■ blue — process / service / reference panel&#xa;■ gray — dense reference / annotation panel&#xa;● numbered circle — request-flow order, steps 1-11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1210" y="900" width="480" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p3_extra" value="SESSION, AUTH &amp; MULTI-STEP TURNS&#xa;&#xa;• Auth — Google OAuth ID-token verification + a JWT session cookie (Domain=.finzorr.ai), handled in app/interface/&#xa;• Session continuity — thread_id = session_id in the LangGraph checkpointer; a conversation survives an api restart&#xa;• Multi-step turns — the supervisor can plan 1-3 steps; each step is sealed into a transient step-bubble in the UI&#xa;• Final frame — carries citations + chart + route, sent once the turn completes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1210" y="1080" width="480" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p4" name="4 . Request Flow and Intent Routing">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4_t" value="REQUEST FLOW &amp; INTENT ROUTING — one supervisor LLM call returns {route, plan, reason}; a deterministic fallback and multi-step planning (bounded parallelism, one-shot replan) keep routing reliable even when the LLM is down." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1660" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p4_chat" value="User message arrives" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p4_int" value="SUPERVISOR — ONE LLM call&#xa;returns {route, plan, reason} JSON&#xa;app/orchestration/supervisor.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="280" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p4_llmok" value="LLM call succeeded &amp; route valid?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="280" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p4_fallback" value="NO → deterministic regex/keyword&#xa;fallback router — LIVE, covers&#xa;the LLM-down case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_routes" value="7 ROUTES — ROUTES frozenset&#xa;app/orchestration/supervisor.py&#xa;&#xa;general_chat ........... 8/10&#xa;rag ............................ 5/5&#xa;nl2sql ....................... 7/7&#xa;tools ......................... 10/11&#xa;research ................... 3/3&#xa;memory ..................... 8/8&#xa;web_search .............. 6/6&#xa;&#xa;(correct/total per category,&#xa;from the routing_eval baseline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="60" width="300" height="330" as="geometry" />
        </mxCell>
        <mxCell id="p4_contract" value="SUPERVISOR OUTPUT SHAPE (one LLM call)&#xa;&#xa;{&#xa;  &quot;route&quot;: &quot;&lt;one of 7 routes&gt;&quot;,&#xa;  &quot;plan&quot;: [ {&quot;route&quot;: ..., &quot;task&quot;: ...} ],&#xa;  &quot;reason&quot;: &quot;&lt;short justification&gt;&quot;&#xa;}    // plan has 1-3 steps&#xa;&#xa;• Fallback: deterministic regex/keyword&#xa;   router used when the LLM call is down&#xa;   or returns an invalid route&#xa;• recursion_limit=50 — explicit backstop&#xa;   (langgraph 1.x default is far higher)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="60" width="430" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p4_docaware" value="DOCUMENT-AWARENESS FIX (real bug, fixed) — LIVE&#xa;&#xa;Supervisor loads the user&#39;s ready upload&#xa;filenames (up to 20) so it KNOWS documents&#xa;exist. Deterministic keyword floor routes to&#xa;rag whenever the message contains an upload&#xa;filename stem (4+ chars) — a backstop even&#xa;if the LLM planner is down." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="280" width="430" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p4_eval" value="ROUTING EVAL BASELINE — recorded CI gate result&#xa;&#xa;Overall: 47/50 = 94.0%&#xa;&#xa;Per-category (correct/total):&#xa;  general_chat 8/10        memory 8/8&#xa;  nl2sql 7/7                    rag 5/5&#xa;  research 3/3                tools 10/11&#xa;  web_search 6/6&#xa;&#xa;Exact 3 misroutes:&#xa;  &quot;Explain compound interest simply&quot;&#xa;      (general_chat → rag)&#xa;  &quot;What is inflation?&quot; (general_chat → rag)&#xa;  &quot;Fetch the latest quote for ITC&quot;&#xa;      (tools → web_search)&#xa;&#xa;Held-out paraphrase set: 15% — informational&#xa;only, NOT gated&#xa;&#xa;CI GATE: 90% minimum accuracy — PASSES at 94.0%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="60" width="500" height="360" as="geometry" />
        </mxCell>
        <mxCell id="p4_e1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p4_chat" target="p4_int">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p4_int" target="p4_llmok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e3" value="no" style="endArrow=block;html=1;strokeColor=#5f6368;fontSize=10;" edge="1" parent="1" source="p4_llmok" target="p4_fallback">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e4" value="yes" style="endArrow=block;html=1;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="p4_llmok" target="p4_routes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e5" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p4_fallback" target="p4_routes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_mstitle" value="MULTI-STEP PLANNING: supervisor emits a 1-3 step plan (route/task pairs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="640" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p4_plan" value="PLAN[] — array of {route, task}&#xa;1-3 steps emitted by the supervisor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p4_advance" value="ADVANCE graph node walks the plan&#xa;step_context helper feeds each completed&#xa;step&#39;s fenced output into the next&#xa;step&#39;s prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="586" width="280" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p4_allroutes" value="Reaches all 7 routes now&#xa;(not just some) — LIVE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="682" width="280" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p4_pardecide" value="Are all step routes one of&#xa;{general_chat, web_search, nl2sql, rag}?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="510" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p4_parallel" value="YES → PARALLEL&#xa;LangGraph Send mechanism fans out&#xa;independent steps concurrently" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="586" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p4_sequential" value="NO → SEQUENTIAL&#xa;tools / research / memory are excluded&#xa;from parallelization by design&#xa;(interrupts, side effects, multi-stage&#xa;pipelines)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="682" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p4_stepfail" value="Step execution → step_error flag set?&#xa;(never prose-sniffed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="510" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p4_replan" value="YES → REPLAN node&#xa;gets exactly ONE revision attempt&#xa;of the remaining steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="586" width="300" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p4_revcheck" value="Revision empty?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="672" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_earlyexit" value="YES → honest early exit&#xa;failure surfaced to the user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="742" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p4_continue" value="NO → continue executing the&#xa;revised remaining steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1020" y="672" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_e6" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p4_mstitle" target="p4_plan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e7" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p4_plan" target="p4_advance">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e8" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p4_advance" target="p4_allroutes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e9" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p4_plan" target="p4_pardecide">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e10" value="yes" style="endArrow=block;html=1;strokeColor=#34a853;fontSize=10;" edge="1" parent="1" source="p4_pardecide" target="p4_parallel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e11" value="no" style="endArrow=block;html=1;strokeColor=#5f6368;fontSize=10;" edge="1" parent="1" source="p4_pardecide" target="p4_sequential">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e12" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p4_advance" target="p4_stepfail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e13" value="yes" style="endArrow=block;html=1;strokeColor=#c5221f;fontSize=10;" edge="1" parent="1" source="p4_stepfail" target="p4_replan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e14" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p4_replan" target="p4_revcheck">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e15" value="empty" style="endArrow=block;html=1;strokeColor=#c5221f;fontSize=10;" edge="1" parent="1" source="p4_revcheck" target="p4_earlyexit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e16" value="not empty" style="endArrow=block;html=1;strokeColor=#34a853;fontSize=10;" edge="1" parent="1" source="p4_revcheck" target="p4_continue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_hitl" value="HUMAN-IN-THE-LOOP (HITL) — LIVE&#xa;&#xa;Sensitive tools (the HITL_TOOLS set,&#xa;default: run_python) pause the graph&#xa;via interrupt()&#xa;&#xa;The WebSocket approval flow resumes&#xa;execution via a Command with resume set&#xa;&#xa;A decline substitutes an honest refusal&#xa;(never silently continues)&#xa;&#xa;The pause is DURABLE — survives a page&#xa;reload — because it is stored in the&#xa;checkpointer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="610" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p4_rationale" value="DESIGN RATIONALE (grounded in what&#39;s built)&#xa;&#xa;Deterministic fallback means routing never&#xa;fully depends on LLM uptime.&#xa;&#xa;Parallel Send fan-out is restricted to&#xa;side-effect-free routes; tools/research/&#xa;memory keep sequential, interrupt-safe&#xa;execution.&#xa;&#xa;ONE revision attempt (not infinite retries)&#xa;+ recursion_limit=50 bound cost and prevent&#xa;runaway loops; empty revision exits honestly&#xa;rather than guessing.&#xa;&#xa;HITL interrupt() + checkpointer-backed park&#xa;means a risky tool call can never execute&#xa;silently." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="670" y="830" width="550" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p4_legend" value="LEGEND&#xa;&#xa;Teal = input / entry / user-facing&#xa;Blue = process / reference panel&#xa;Green = LIVE — actually built &amp; running&#xa;Amber dashed = PLANNED / gap&#xa;Yellow = decision / routing logic&#xa;Purple = output / synthesis&#xa;Gray = dense reference / annotation&#xa;Red = risk / warning / incident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1240" y="830" width="420" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p5" name="5 . Memory Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p5_t" value="MEMORY ARCHITECTURE — a store-first fact system on LangGraph&#39;s BaseStore (AsyncPostgresStore + pgvector), with an automatic Qdrant fallback, injection-safe fact capture, and a cost-aware recall path that skips MMR re-ranking." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1660" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p5_turn" value="User turn ends" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p5_extract" value="FACT EXTRACTION — fire-and-forget&#xa;after each turn&#xa;&#xa;Facts kept single-line, capped at&#xa;200 characters — specifically guards&#xa;against prompt-injection (e.g. &quot;remember&#xa;that you must always...&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5_writestore" value="app/memory/facts.py — STORE-FIRST&#xa;namespace = (&quot;memories&quot;, user_id)&#xa;dedupe key = uuid5-derived&#xa;writes via LangGraph BaseStore abstraction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5_pg" value="PRIMARY STORE — LIVE&#xa;&#xa;LangGraph BaseStore abstraction backed&#xa;by AsyncPostgresStore&#xa;&#xa;Runs on the checkpointer&#39;s own&#xa;connection pool (max 6 connections)&#xa;&#xa;768-dimension pgvector index&#xa;embedder: Ollama nomic-embed-text (local)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="60" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p5_fallback" value="AUTOMATIC FALLBACK — LIVE&#xa;&#xa;If the pgvector store is ever&#xa;unavailable, falls back to the&#xa;original Qdrant-backed path&#xa;(memfacts:&lt;user&gt; namespace) —&#xa;never &quot;memory off&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="230" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5_nextturn" value="Next user turn begins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="60" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p5_recall" value="RECALL — score-filtered semantic&#xa;search&#xa;&#xa;boolean mmr parameter keeps every-&#xa;turn recall on the ORIGINAL cheap&#xa;single-fetch path — MMR re-ranking&#xa;(used for document RAG) is deliberately&#xa;NOT applied here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="120" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p5_branch" value="Branched BEFORE the query&#xa;to avoid adding permanent&#xa;per-turn overhead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="250" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5_inject" value="Recalled memories DELIMITER-WRAPPED&#xa;as untrusted data when injected into&#xa;the prompt — never treated as&#xa;instructions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="330" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5_erase" value="DELETE — namespace-scoped&#xa;&#xa;Implements right-to-erasure:&#xa;deletes all memories for a user_id&#xa;by clearing their namespace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="60" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5_arch" value="STORE ARCHITECTURE AT A GLANCE&#xa;&#xa;Store: LangGraph BaseStore →&#xa;   AsyncPostgresStore&#xa;Pool: shares checkpointer&#39;s own&#xa;   connection pool (max 6 connections)&#xa;Index: pgvector, 768-dimension&#xa;Embedder: Ollama nomic-embed-text (local)&#xa;Namespace: (&quot;memories&quot;, user_id)&#xa;Dedupe: uuid5-derived keys&#xa;Fallback: Qdrant memfacts:&lt;user&gt;&#xa;   namespace (never &quot;memory off&quot;)&#xa;Recall: score-filtered semantic search,&#xa;   mmr=False (cheap single-fetch)&#xa;Delete: namespace-scoped&#xa;   (right-to-erasure)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1300" y="60" width="380" height="310" as="geometry" />
        </mxCell>
        <mxCell id="p5_e1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p5_turn" target="p5_extract">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p5_extract" target="p5_writestore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e3" value="write" style="endArrow=block;html=1;strokeColor=#5f6368;fontSize=10;" edge="1" parent="1" source="p5_writestore" target="p5_pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e4" value="if unavailable" style="endArrow=block;html=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="p5_pg" target="p5_fallback">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e5" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p5_nextturn" target="p5_recall">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e6" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p5_recall" target="p5_branch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e7" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p5_branch" target="p5_inject">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e8" value="query" style="endArrow=block;html=1;strokeColor=#5f6368;fontSize=10;" edge="1" parent="1" source="p5_pg" target="p5_recall">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e9" value="namespace-scoped delete" style="endArrow=block;html=1;strokeColor=#5f6368;fontSize=10;" edge="1" parent="1" source="p5_pg" target="p5_erase">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_why" value="DESIGN RATIONALE (grounded in what&#39;s built)&#xa;&#xa;Cost: mmr=False keeps memory recall on&#xa;the original cheap single-fetch path —&#xa;MMR re-ranking only runs for document&#xa;RAG, so every-turn memory lookups don&#39;t&#xa;carry permanent extra overhead.&#xa;&#xa;Security: facts capped at 200 chars,&#xa;single-line, guards against prompt-&#xa;injection; recalled memories are&#xa;delimiter-wrapped as untrusted data,&#xa;never treated as instructions.&#xa;&#xa;Reliability: automatic Qdrant fallback&#xa;means memory never goes fully &quot;off&quot; if&#xa;pgvector is unavailable.&#xa;&#xa;Compliance: namespace-scoped delete is&#xa;a real right-to-erasure implementation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="640" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p5_lifecycle" value="MEMORY LIFECYCLE (write → read)&#xa;&#xa;1. Turn ends → fire-and-forget fact&#xa;    extraction (single-line, ≤200 chars)&#xa;2. Write via BaseStore → AsyncPostgresStore&#xa;    (pgvector, 768-dim, namespace=(memories,&#xa;    user_id)), dedupe key = uuid5&#xa;3. Next turn → score-filtered semantic&#xa;    recall (mmr=False, cheap single-fetch)&#xa;4. Recalled facts delimiter-wrapped as&#xa;    untrusted data → injected into prompt&#xa;5. On pgvector unavailability → automatic&#xa;    Qdrant fallback (memfacts:&lt;user&gt;&#xa;    namespace)&#xa;6. Delete = namespace-scoped&#xa;    (right-to-erasure)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="450" width="580" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p5_legend" value="LEGEND&#xa;&#xa;Teal = input / entry / user-facing&#xa;Blue = process / reference panel&#xa;Green = LIVE — actually built &amp; running&#xa;Amber dashed = PLANNED / gap&#xa;Yellow = decision / routing logic&#xa;Purple = output / synthesis&#xa;Gray = dense reference / annotation&#xa;Red = risk / warning / incident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1300" y="450" width="380" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p6" name="6 . RAG Pipeline Deep-Dive">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p6_t" value="RAG PIPELINE DEEP-DIVE — two corpora (per-user uploaded documents + shared glossary/fundamentals), one shared pipeline. Left lane = ingestion (offline, app/documents/ingest.py). Right lane = query-time retrieval, re-ranking, and citation integrity (app/specialists/rag.py)." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1660" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p6_lane1" value="INGESTION LANE (offline) — app/documents/ingest.py" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#00897b;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p6_i1" value="Upload&#xa;Per-user documents (private) OR shared glossary / fundamentals corpus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p6_i2" value="Extract (format-specific)&#xa;PDF → PyMuPDF, Tesseract-OCR fallback per page under 40 chars&#xa;DOCX → python-docx&#xa;PPTX → python-pptx (1 pseudo-page per slide)&#xa;XLSX/XLS → openpyxl/xlrd (1 pseudo-page per sheet)&#xa;CSV/TXT/MD → plain decode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p6_i3" value="PII detection at ingest (app/domain/pii.py)&#xa;Email · phone · PAN-shaped · Aadhaar-shaped · card-shaped ·&#xa;IFSC via anchored regex — TYPE only recorded, never the value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6_i4" value="Chunk (app/domain/chunking.py)&#xa;Fixed-size windows with format-natural locators:&#xa;p.3 · slide 4 · sheet:Revenue · section 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p6_i5" value="Embed&#xa;Ollama nomic-embed-text, batched" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6_i6" value="Upsert → Qdrant (app/infrastructure/vector_store.py)&#xa;Tenant-partitioned by user_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p6_ie1" style="endArrow=block;html=1;strokeColor=#00897b;" edge="1" parent="1" source="p6_i1" target="p6_i2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_ie2" style="endArrow=block;html=1;strokeColor=#00897b;" edge="1" parent="1" source="p6_i2" target="p6_i3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_ie3" style="endArrow=block;html=1;strokeColor=#00897b;" edge="1" parent="1" source="p6_i3" target="p6_i4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_ie4" style="endArrow=block;html=1;strokeColor=#00897b;" edge="1" parent="1" source="p6_i4" target="p6_i5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_ie5" style="endArrow=block;html=1;strokeColor=#00897b;" edge="1" parent="1" source="p6_i5" target="p6_i6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_lane2" value="QUERY LANE (per request) — app/specialists/rag.py" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#1a73e8;" vertex="1" parent="1">
          <mxGeometry x="380" y="50" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p6_q1" value="Question&#xa;User asks a question in chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="80" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6_q2" value="Retrieval — Qdrant search&#xa;Filtered to exactly the glossary corpus + the requesting&#xa;user. Tenant isolation is seam-tested — a future refactor&#xa;cannot silently widen it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="140" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p6_q3" value="Injection guard on retrieved excerpts&#xa;(app/domain/guard.py — screen_floor + optional LLM tier)&#xa;Excerpts containing override phrasing get&#xa;guard:doc_injection_suspected — layered on content-fencing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="260" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p6_q4" value="MMR re-ranking (app/domain/retrieval.py —&#xa;the _mmr_select function)&#xa;Pure-Python cosine similarity — fetch top_k × 2 candidates,&#xa;diversity-select to top_k, rank-1 hit always kept as a floor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="380" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p6_q5" value="Small-document full-read gate&#xa;≤8 chunks read IN FULL when 2+ same-doc hits OR&#xa;explicit whole-document intent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="490" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p6_q6" value="Grounded synthesis (LLM)&#xa;Cites retrieved excerpts, streamed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="590" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p6_q7" value="Citation integrity check&#xa;(app/domain/citations.py — find_invalid_markers)&#xa;Runtime range-check of markers against the retrieved set;&#xa;tag-only, never mangles the answer text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="660" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p6_q8" value="Answer with citations&#xa;Bracketed-number markers map to the retrieved set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="780" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p6_qe1" style="endArrow=block;html=1;strokeColor=#1a73e8;" edge="1" parent="1" source="p6_q1" target="p6_q2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_qe2" style="endArrow=block;html=1;strokeColor=#1a73e8;" edge="1" parent="1" source="p6_q2" target="p6_q3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_qe3" style="endArrow=block;html=1;strokeColor=#1a73e8;" edge="1" parent="1" source="p6_q3" target="p6_q4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_qe4" style="endArrow=block;html=1;strokeColor=#1a73e8;" edge="1" parent="1" source="p6_q4" target="p6_q5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_qe5" style="endArrow=block;html=1;strokeColor=#1a73e8;" edge="1" parent="1" source="p6_q5" target="p6_q6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_qe6" style="endArrow=block;html=1;strokeColor=#1a73e8;" edge="1" parent="1" source="p6_q6" target="p6_q7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_qe7" style="endArrow=block;html=1;strokeColor=#1a73e8;" edge="1" parent="1" source="p6_q7" target="p6_q8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_xe" value="index feeds retrieval" style="endArrow=block;html=1;dashed=1;strokeColor=#5f6368;fontSize=10;" edge="1" parent="1" source="p6_i6" target="p6_q2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_corpora" value="TWO CORPORA, ONE PIPELINE&#xa;&#xa;• Per-user uploaded documents — private, tenant-owned&#xa;• Shared glossary / fundamentals corpus — common&#xa;   reference data available to every user&#xa;&#xa;Both flow through the same ingest pipeline&#xa;(app/documents/ingest.py): extract → chunk → embed → upsert.&#xa;&#xa;Retrieval (app/specialists/rag.py) is filtered to exactly&#xa;the glossary corpus PLUS the requesting user — never any&#xa;other user&#39;s documents." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="60" width="480" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p6_mmr" value="MMR RE-RANKING (app/domain/retrieval.py — _mmr_select)&#xa;&#xa;Pure-Python cosine similarity — no new dependency.&#xa;1. Fetch top_k × 2 candidates from Qdrant&#xa;2. Diversity-select down to top_k, balancing relevance&#xa;   against redundancy with already-selected chunks&#xa;3. Rank-1 hit is ALWAYS kept — relevance is never&#xa;   sacrificed for diversity&#xa;LIVE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="300" width="480" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p6_wholedoc" value="SMALL-DOCUMENT FULL READ&#xa;&#xa;Documents of 8 chunks or fewer that clearly match are read&#xa;IN FULL rather than piecemeal.&#xa;&#xa;Gated on:&#xa;• 2 or more chunk hits from the same document, OR&#xa;• explicit whole-document intent in the question&#xa;&#xa;Purpose: stop one lucky chunk match from pulling in an&#xa;entire irrelevant document. LIVE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="520" width="480" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p6_eval" value="RAG EVAL — REAL RECORDED RESULTS (rag_eval)&#xa;&#xa;• Retrieval hit-rate: 15/15 = 100% (gate ≥ 90%)&#xa;• Faithfulness judge score: 8.2 / 10 (gate ≥ 7)&#xa;• injection_eval: 76/76 = 100%&#xa;&#xa;These are actual recorded eval-suite results, not targets." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="740" width="480" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p6_citation" value="CITATION INTEGRITY — RUNTIME FLOOR&#xa;(app/domain/citations.py — find_invalid_markers)&#xa;&#xa;Every bracketed-number marker [n] in a generated answer is&#xa;range-checked against the actual retrieved set — AT RUNTIME,&#xa;not just in offline evals.&#xa;&#xa;• Marker out of range → citation:invalid tag&#xa;• Real retrieval hits but ZERO citation markers →&#xa;   hallucination:no_citations tag&#xa;&#xa;Both are deterministic floors, tag-only — they never mangle&#xa;the answer text itself. LIVE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="60" width="490" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p6_security" value="SECURITY: PII AT INGEST + INJECTION GUARD&#xa;&#xa;PII detection (app/domain/pii.py) — email, phone,&#xa;PAN-shaped, Aadhaar-shaped, card-shaped, IFSC via anchored&#xa;regex. Only the TYPE is recorded — never the value itself.&#xa;&#xa;Jailbreak / injection guard (app/domain/guard.py —&#xa;screen_floor pattern-floor function, plus an optional LLM&#xa;tier). Retrieved excerpts that themselves contain override&#xa;phrasing get a guard:doc_injection_suspected tag.&#xa;&#xa;Layered ON TOP OF — never instead of — content-fencing of&#xa;untrusted text. LIVE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="330" width="490" height="280" as="geometry" />
        </mxCell>
        <mxCell id="p6_legend" value="LEGEND&#xa;&#xa;Teal = input / entry / user-facing&#xa;Blue = process / service / reference panel&#xa;Green = LIVE — actually built and running&#xa;Amber dashed = PLANNED / identified gap&#xa;Yellow = decision point / routing logic&#xa;Purple = output / synthesis / streamed result&#xa;Gray = dense reference / annotation panel&#xa;Red = risk / security-relevant control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="620" width="490" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p7" name="7 . NL2SQL Pipeline Deep-Dive">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p7_t" value="NL2SQL PIPELINE DEEP-DIVE — a guarded natural-language-to-SQL screener over Indian stock fundamentals data (app/nl2sql/). AST-level validation, a genuinely separate read-only execution role, one self-correcting retry, and versioned prompts are the built controls shown below. A full worked example — real request through response, including a realistic retry — is at the bottom of this page." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1660" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p7_s1" value="Question&#xa;Natural-language question over Indian stock&#xa;fundamentals data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="60" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p7_s2" value="Prompt — nl2sql_generator (versioned AgentPrompt)&#xa;prompt_registry.py — treated like code: reviewable,&#xa;rollback-able. Real revisions shipped, e.g. adding&#xa;SQL-dialect-specific rules after a live failure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p7_s3" value="LLM generates SQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="260" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p7_s4" value="Validation — sqlglot (AST-level checks)&#xa;SELECT INTO rejected · table-free DoS/probing shapes&#xa;(pg_sleep, generate_series) rejected · only the required&#xa;whitelisted table permitted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p7_s5" value="Execution — READ-ONLY database role&#xa;Genuinely separate role, distinct connection string from&#xa;the main app&#39;s read-write connection · LIMIT-clamped results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="460" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p7_s6" value="Valid and executes?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="140" y="570" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p7_s8" value="Results delivered to user&#xa;LIMIT-clamped rows from the whitelisted fundamentals table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="630" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p7_e1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p7_s1" target="p7_s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7_e2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p7_s2" target="p7_s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7_e3" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p7_s3" target="p7_s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7_e4" value="valid" style="endArrow=block;html=1;strokeColor=#34a853;fontSize=10;" edge="1" parent="1" source="p7_s4" target="p7_s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7_e5" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p7_s5" target="p7_s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7_e6" value="error → retry ONCE with error message attached to prompt" style="endArrow=block;html=1;dashed=1;strokeColor=#c5221f;fontColor=#c5221f;fontSize=10;" edge="1" parent="1" source="p7_s6" target="p7_s3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="590" />
              <mxPoint x="420" y="285" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p7_e7" value="yes" style="endArrow=block;html=1;strokeColor=#34a853;fontSize=10;" edge="1" parent="1" source="p7_s6" target="p7_s8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7_datalabel" value="DATA SOURCE (background)" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#34a853;" vertex="1" parent="1">
          <mxGeometry x="460" y="270" width="260" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p7_refresh" value="Daily fundamentals-refresh job&#xa;app/nl2sql/jobs/refresh_fundamentals.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="300" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p7_data" value="Indian stock fundamentals data&#xa;(required whitelisted table)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="400" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p7_de1" value="keeps current" style="endArrow=block;html=1;strokeColor=#34a853;fontSize=10;" edge="1" parent="1" source="p7_refresh" target="p7_data">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7_de2" value="source table" style="endArrow=block;html=1;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="p7_data" target="p7_s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7_valid" value="SQL VALIDATION — sqlglot (AST-level checks)&#xa;&#xa;• SELECT INTO — rejected&#xa;• Table-free queries (pg_sleep, generate_series, and&#xa;   similar DoS / probing shapes) — rejected&#xa;• Only the required whitelisted table is permitted&#xa;&#xa;Checks operate on the parsed AST, not string matching. LIVE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="60" width="470" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p7_exec" value="READ-ONLY EXECUTION&#xa;&#xa;A genuinely separate READ-ONLY database role — a distinct&#xa;connection string from the main app&#39;s read-write connection.&#xa;&#xa;Results are LIMIT-clamped.&#xa;&#xa;Even a validator bypass cannot write, because the executing&#xa;role has no write privilege at the database level. LIVE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="250" width="470" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p7_retry" value="SELF-CORRECTION (ONE RETRY)&#xa;&#xa;If the first generation attempt fails validation OR&#xa;execution, the actual error message is attached to the&#xa;prompt and the LLM gets exactly one automatic retry.&#xa;&#xa;No unbounded retry loop. LIVE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="470" width="470" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p7_prompt" value="PROMPT VERSIONING (prompt_registry.py)&#xa;&#xa;nl2sql_generator is a versioned AgentPrompt object.&#xa;&#xa;It has gone through real revisions — for example, adding&#xa;SQL-dialect-specific rules after a live failure.&#xa;&#xa;Prompts are treated like code: reviewable and&#xa;rollback-able. LIVE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1260" y="60" width="430" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p7_fresh" value="DATA FRESHNESS&#xa;&#xa;Daily fundamentals-refresh job&#xa;(app/nl2sql/jobs/refresh_fundamentals.py) keeps the&#xa;screened Indian stock fundamentals data current. LIVE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1260" y="270" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p7_legend" value="LEGEND&#xa;&#xa;Teal = input / entry / user-facing&#xa;Blue = process / service / reference panel&#xa;Green = LIVE — actually built and running&#xa;Amber dashed = PLANNED / identified gap&#xa;Yellow = decision point / routing logic&#xa;Purple = output / synthesis / streamed result&#xa;Gray = dense reference / annotation panel&#xa;Red = risk / security-relevant control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1260" y="410" width="430" height="220" as="geometry" />
        </mxCell>

        <mxCell id="p7_ex_t" value="WORKED EXAMPLE — ONE REAL REQUEST, START TO FINISH (with a realistic self-correction retry). Illustrative SQL and result data below — not live figures — but the mechanism (prompt → generate → validate → execute → retry-on-error → respond) is exactly what runs in production." style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="1640" height="34" as="geometry" />
        </mxCell>

        <mxCell id="p7_ex_q" value="1 — User question&#xa;&#xa;&quot;Show me stocks with P/E below 15 and dividend yield above 3%&quot;&#xa;&#xa;A screening question over MANY stocks — exactly nl2sql&#39;s job (vs. tools/rag for a single-stock lookup)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="784" width="310" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p7_ex_prompt1" value="2 — Prompt sent to LLM (attempt 1)&#xa;&#xa;nl2sql_generator (versioned prompt) + schema summary (ticker, price, eps, pe_ratio, dividend_yield, ...) + the question above, formatted as instructions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="370" y="784" width="310" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p7_ex_sql1" value="3 — SQL generated (attempt 1)&#xa;&#xa;SELECT ticker, pe_ratio, div_yield&#xa;FROM fundamentals&#xa;WHERE pe_ratio &lt; 15 AND div_yield &gt; 3&#xa;ORDER BY pe_ratio;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="784" width="310" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p7_ex_val1" value="4 — Validation — sqlglot&#xa;&#xa;PASSES the AST checks: SELECT-only, whitelisted table, no destructive/DoS shapes.&#xa;&#xa;Column names are NOT checked here — that&#39;s the database&#39;s job next." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1030" y="784" width="310" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p7_ex_exec1" value="5 — Execution — READ-ONLY role&#xa;&#xa;FAILS with a real Postgres error:&#xa;&#xa;column &quot;div_yield&quot; does not exist&#xa;(real column is dividend_yield)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1360" y="784" width="310" height="200" as="geometry" />
        </mxCell>

        <mxCell id="p7_ex_retry" value="6 — Self-correction — ONE automatic retry&#xa;&#xa;The exact Postgres error text above is appended to the prompt, and the LLM is asked to regenerate — same mechanism as the SELF-CORRECTION panel above, now shown with a real, specific error." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1044" width="310" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p7_ex_sql2" value="7 — SQL generated (attempt 2)&#xa;&#xa;SELECT ticker, price, pe_ratio, dividend_yield&#xa;FROM fundamentals&#xa;WHERE pe_ratio &lt; 15 AND dividend_yield &gt; 3&#xa;ORDER BY pe_ratio ASC&#xa;LIMIT 500;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1044" width="310" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p7_ex_val2" value="8 — Validation — sqlglot&#xa;&#xa;PASSES — correct column name this time, still SELECT-only, still the whitelisted table only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="700" y="1044" width="310" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p7_ex_exec2" value="9 — Execution — READ-ONLY role&#xa;&#xa;SUCCEEDS. Illustrative example rows (not live data):&#xa;&#xa;STOCK_A   P/E 11.2   yield 4.1%&#xa;STOCK_B   P/E 13.8   yield 3.4%&#xa;STOCK_C   P/E 14.6   yield 3.2%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1030" y="1044" width="310" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p7_ex_resp" value="10 — Response delivered to user&#xa;&#xa;&quot;3 stocks match your screen (P/E &lt; 15, dividend yield &gt; 3%): STOCK_A (P/E 11.2, yield 4.1%), STOCK_B (P/E 13.8, yield 3.4%), STOCK_C (P/E 14.6, yield 3.2%).&quot;&#xa;&#xa;Streamed token-by-token, same as every other route." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1360" y="1044" width="310" height="220" as="geometry" />
        </mxCell>

        <mxCell id="p7_ex_e1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p7_ex_q" target="p7_ex_prompt1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7_ex_e2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p7_ex_prompt1" target="p7_ex_sql1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7_ex_e3" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p7_ex_sql1" target="p7_ex_val1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7_ex_e4" value="AST OK" style="endArrow=block;html=1;strokeColor=#34a853;fontSize=10;" edge="1" parent="1" source="p7_ex_val1" target="p7_ex_exec1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7_ex_e5" value="DB error → retry" style="endArrow=block;html=1;dashed=1;strokeColor=#c5221f;fontColor=#c5221f;fontSize=10;" edge="1" parent="1" source="p7_ex_exec1" target="p7_ex_retry">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1515" y="1024" />
              <mxPoint x="195" y="1024" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p7_ex_e6" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p7_ex_retry" target="p7_ex_sql2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7_ex_e7" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p7_ex_sql2" target="p7_ex_val2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7_ex_e8" value="AST OK" style="endArrow=block;html=1;strokeColor=#34a853;fontSize=10;" edge="1" parent="1" source="p7_ex_val2" target="p7_ex_exec2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7_ex_e9" value="success" style="endArrow=block;html=1;strokeColor=#34a853;fontSize=10;" edge="1" parent="1" source="p7_ex_exec2" target="p7_ex_resp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p8" name="8 · Agents, Function Calling &amp; Frameworks">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p8_t" value="AGENTS, FUNCTION CALLING &amp; FRAMEWORKS — LangGraph 1.2.x StateGraph orchestrates every turn; the tool dispatcher schema-validates every model-supplied argument BEFORE a handler runs and never raises, so one broken tool degrades an answer instead of crashing it." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1660" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p8_c1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="74" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p8_s1" value="Worker specialist emits a tool call request&#xa;LLM returns a TOOL REQUEST (not an action) — schema-declared args, dispatched via app/tools_registry/dispatcher.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p8_c2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="156" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p8_s2" value="validate_arguments() checks the call&#xa;model-supplied arguments checked against each tool&#39;s declared types — BEFORE the handler ever runs (LIVE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="134" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p8_c3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="246" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p8_s3" value="Handler executes&#xa;within its per-family timeout budget — 20s default · research 120s · image 75s (set via register_tool(definition, handler, timeout_s))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="224" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p8_c4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="336" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p8_s4" value="Dispatcher NEVER raises&#xa;any failure returns an LLM-visible error string instead of throwing — one broken tool degrades the answer, it does not crash the turn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="314" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p8_c5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="418" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p8_s5" value="Result (or error string) returned to the graph&#xa;appended to shared state — the calling specialist continues the turn or responds to the user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="404" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p8_e1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p8_s1" target="p8_s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p8_e2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p8_s2" target="p8_s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p8_e3" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p8_s3" target="p8_s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p8_e4" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p8_s4" target="p8_s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p8_legend" value="LEGEND&#xa;&#xa;Teal = input / entry / user-facing&#xa;Blue = process / service / reference&#xa;Green = LIVE — actually built &amp; running&#xa;Amber dashed = PLANNED / identified gap&#xa;Yellow = decision point / routing logic&#xa;Purple = output / synthesis / streamed result&#xa;Gray = dense reference / annotation panel&#xa;Red = risk / warning / incident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="490" width="340" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p8_fw" value="FRAMEWORK CHOICE — LANGGRAPH 1.2.x STATEGRAPH (LIVE)&#xa;&#xa;Chosen over a bespoke agent loop specifically for:&#xa;• Typed, checkpointed state — graph state persists across turns&#xa;• Conditional edges — supervisor output routes to the correct worker node(s)&#xa;• Send-based parallel fan-out — LangGraph Send() genuinely fans out eligible routes in parallel (worked example: Page 9)&#xa;• Interrupt-based human-in-the-loop — a run can pause mid-graph for approval/input&#xa;&#xa;All four are used for real in production today, not merely available unused." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="60" width="600" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p8_disp" value="TOOL DISPATCHER — app/tools_registry/dispatcher.py (LIVE)&#xa;&#xa;register_tool(definition, handler, timeout_s) — every tool is registered with its schema, its handler, and its own timeout budget.&#xa;&#xa;validate_arguments(...) checks model-supplied arguments against each tool&#39;s declared types BEFORE the handler ever runs.&#xa;&#xa;The dispatcher NEVER raises. Every failure path returns an LLM-visible error string instead of throwing — one broken tool degrades an answer, it never crashes the turn.&#xa;&#xa;PER-TOOL-FAMILY TIMEOUT BUDGETS (declared at registration):&#xa;• research tools — 120s&#xa;• image tools — 75s&#xa;• most tools — 20s default&#xa;&#xa;Why per-family, not one global cap: a single global timeout once made deep research structurally impossible — budgets are now declared per family at registration time." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="290" width="600" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p8_always" value="ALWAYS-ON TOOL FAMILIES (LIVE)&#xa;&#xa;Imported directly in app/specialists/tools.py — no gating, always registered:&#xa;• market_tools.py&#xa;• portfolio_tools.py&#xa;• web_tools.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1090" y="60" width="570" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p8_opt" value="OPTIONAL TOOL FAMILIES (LIVE where configured)&#xa;&#xa;Registered inside app/main.py startup lifespan — each wrapped in its OWN independent try/except:&#xa;&#xa;• code_tools.py — sandboxed Python interpreter: docker run --rm, non-root uid 65534, all capabilities dropped, no-new-privileges, network-none. Dev-only until a security review — OFF in prod.&#xa;• image_tools.py — gated: registers only if an image-generation key is configured.&#xa;• github_client.py — read-only GitHub MCP integration.&#xa;• google_connect.py — Gmail/Calendar via OAuth, encrypted refresh tokens." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1090" y="270" width="570" height="330" as="geometry" />
        </mxCell>
        <mxCell id="p8_fault" value="FAULT ISOLATION BY DESIGN&#xa;&#xa;Each optional integration&#39;s try/except is independent — a deliberate design so one broken optional integration (e.g. missing OAuth config) can never crash startup or take down the others.&#xa;&#xa;Design decision: an explicit per-integration try/except (not a decorator-based auto-discovery registry) was deliberately kept — the existing pattern already balances modularity with resilience." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1090" y="620" width="570" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p9" name="9 · Multi-Agent Sequence (worked example)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p9_t" value="MULTI-AGENT SEQUENCE — real finzorr worked example: &quot;What is TCS P/E ratio, and what does my glossary document say about how to interpret P/E?&quot; — spans nl2sql + rag, genuinely parallel via LangGraph Send(). Read top→bottom; numbers = message order." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1660" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p9_l1" value="User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="160" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p9_l2" value="Cloudflare Tunnel +&#xa;FastAPI (chat_ws.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="250" y="60" width="160" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p9_l3" value="Orchestrator&#xa;(graph.py, AsyncPostgresSaver)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="440" y="60" width="160" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p9_l4" value="Supervisor&#xa;(supervisor.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="630" y="60" width="160" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p9_l5" value="Worker:&#xa;NL2SQL specialist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="820" y="60" width="160" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p9_l6" value="Worker:&#xa;RAG specialist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1010" y="60" width="160" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p9_l7" value="Compose&#xa;(compose.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1200" y="60" width="160" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p9_ll1" style="endArrow=none;dashed=1;strokeColor=#9e9e9e;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="108" as="sourcePoint" />
            <mxPoint x="140" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_ll2" style="endArrow=none;dashed=1;strokeColor=#9e9e9e;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="108" as="sourcePoint" />
            <mxPoint x="330" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_ll3" style="endArrow=none;dashed=1;strokeColor=#9e9e9e;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="108" as="sourcePoint" />
            <mxPoint x="520" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_ll4" style="endArrow=none;dashed=1;strokeColor=#9e9e9e;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="710" y="108" as="sourcePoint" />
            <mxPoint x="710" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_ll5" style="endArrow=none;dashed=1;strokeColor=#9e9e9e;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="108" as="sourcePoint" />
            <mxPoint x="900" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_ll6" style="endArrow=none;dashed=1;strokeColor=#9e9e9e;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="108" as="sourcePoint" />
            <mxPoint x="1090" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_ll7" style="endArrow=none;dashed=1;strokeColor=#9e9e9e;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1280" y="108" as="sourcePoint" />
            <mxPoint x="1280" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_m1" value="1 · user question over the WebSocket: &quot;What is TCS P/E ratio, and what does my glossary document say about how to interpret P/E?&quot;" style="endArrow=block;html=1;strokeColor=#00897b;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="150" as="sourcePoint" />
            <mxPoint x="330" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_m2" value="2 · FastAPI hands off to run_turn() with the session thread_id" style="endArrow=block;html=1;strokeColor=#5f6368;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="205" as="sourcePoint" />
            <mxPoint x="520" y="205" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_m3" value="3 · orchestrator loads checkpointed state (AsyncPostgresSaver), invokes the supervisor" style="endArrow=block;html=1;strokeColor=#5f6368;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="260" as="sourcePoint" />
            <mxPoint x="710" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_m4" value="4 · one LLM call → {route: parallel, plan:[step0 nl2sql &quot;get TCS P/E ratio&quot;, step1 rag &quot;find P/E interpretation in glossary&quot;]}" style="endArrow=block;html=1;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="710" y="315" as="sourcePoint" />
            <mxPoint x="520" y="315" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_m5a" value="5 · both routes are in the parallelizable set → graph fans out via LangGraph Send() — step0 to NL2SQL (real parallel execution, not sequential)" style="endArrow=block;html=1;strokeColor=#34a853;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="370" as="sourcePoint" />
            <mxPoint x="900" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_m5b" value="5 · concurrent fan-out — step1 to RAG" style="endArrow=block;html=1;strokeColor=#34a853;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="400" as="sourcePoint" />
            <mxPoint x="1090" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_m6" value="6 · NL2SQL: sqlglot-validated SELECT vs read-only fundamentals DB → &quot;TCS P/E = 28.4&quot; → written to shared parallel_outputs state" style="endArrow=block;html=1;strokeColor=#5f6368;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="460" as="sourcePoint" />
            <mxPoint x="520" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_m7" value="7 · concurrently, RAG: Qdrant search filtered to glossary+user, MMR re-ranking → excerpt + citation &quot;glossary.pdf, page 7&quot; → parallel_outputs" style="endArrow=block;html=1;strokeColor=#5f6368;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="500" as="sourcePoint" />
            <mxPoint x="520" y="500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_join" value="8 · join node collects both branches, ordered by step index" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="545" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p9_m9a" value="9 · compose_node merges both outputs, remaps citation markers to one global sequence" style="endArrow=block;html=1;strokeColor=#7e57c2;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="615" as="sourcePoint" />
            <mxPoint x="1280" y="615" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_m9b" value="9 · streamed final answer: &quot;TCS P/E ratio is 28.4 [1]. A P/E of X means... [2]&quot; — route badges shown for both specialists (nl2sql, rag)" style="endArrow=block;html=1;strokeColor=#7e57c2;strokeWidth=2;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1280" y="670" as="sourcePoint" />
            <mxPoint x="140" y="670" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_m10" value="10 · persist_node commits the turn; if LangSmith tracing is enabled, the whole turn is traced under one root run with nested llm/tool/retriever spans" style="endArrow=block;html=1;dashed=1;strokeColor=#5f6368;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1280" y="730" as="sourcePoint" />
            <mxPoint x="520" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9_notes" value="EXECUTION SEMANTICS (LIVE)&#xa;&#xa;Parallel fan-out is genuinely LIVE for the 4 eligible routes — general_chat, web_search, nl2sql, rag. LangGraph Send() dispatches them as real concurrent branches, not sequential.&#xa;&#xa;Routes with side effects / interrupts / pipelines — tools, research, memory — ALWAYS stay sequential by design; they are never fanned out.&#xa;&#xa;Workers never talk to each other directly. They read and write a SHARED typed graph state channel (parallel_outputs) — a blackboard pattern." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1440" y="100" width="260" height="340" as="geometry" />
        </mxCell>
        <mxCell id="p9_legend" value="LEGEND&#xa;&#xa;Teal = input / entry / user-facing&#xa;Blue = process / service / reference&#xa;Green = LIVE — actually built &amp; running&#xa;Amber dashed = PLANNED / identified gap&#xa;Yellow = decision point / routing logic&#xa;Purple = output / synthesis / streamed result&#xa;Gray = dense reference / annotation panel&#xa;Red = risk / warning / incident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1440" y="460" width="260" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p10" name="10 . Model Selection and Benchmarking">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p10_t" value="MODEL SELECTION &amp; BENCHMARKING — the real provider cascade behind app/infrastructure/llm/. One OpenAICompatibleProvider class, one openai-SDK call shape, a swappable base_url per vendor. Every fallback below is a hard resource constraint, not a preference." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1660" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p10_c1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="67" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p10_c2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="129" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p10_c3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="195" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p10_c4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="269" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p10_c5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="339" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p10_c6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="399" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p10_c7" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="463" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p10_c8" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="527" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p10_c9" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="587" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p10_s1" value="User chat / tool-call request enters the LLM layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="60" width="270" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p10_s2" value="Redis per-user rate limit check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="118" width="270" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p10_s3" value="Global per-provider daily token budget check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="184" width="270" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p10_s4" value="OpenAICompatibleProvider&#xa;app/infrastructure/llm/ — one class, openai SDK, swappable base_url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="250" width="270" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p10_s5" value="Groq — llama-3.3-70b-versatile — PRIMARY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="332" width="270" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p10_s6" value="Gemini — gemini-2.0-flash — FALLBACK on Groq error / quota" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="388" width="270" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p10_s7" value="OpenRouter — free-tagged models only — optional extra fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="452" width="270" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p10_s8" value="Ollama (local) — llama3.2:3b-instruct-fp16 — EMERGENCY fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="516" width="270" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p10_s9" value="Response streamed to user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="580" width="270" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p10_s10" value="Embedding request (RAG / memory / any route) — parallel path, never through the cloud fallback chain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="650" width="270" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p10_s11" value="Ollama nomic-embed-text:v1.5 — ALWAYS local, $0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="704" width="270" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p10_legend" value="LEGEND&#xa;&#xa;Teal = input / entry / user-facing&#xa;Blue = process / service / reference&#xa;Green = LIVE — actually built &amp; running&#xa;Amber dashed = PLANNED / gap (none on this page — the whole chain is live)&#xa;Yellow = decision / routing logic&#xa;Purple = output / synthesis / streamed result&#xa;Gray = dense reference / annotation panel&#xa;Red = risk / warning / incident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="790" width="270" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p10_e1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p10_s1" target="p10_s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10_e2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p10_s2" target="p10_s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10_e3" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p10_s3" target="p10_s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10_e4" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p10_s4" target="p10_s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10_e5" value="error / quota exhausted" style="endArrow=block;html=1;dashed=1;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="p10_s5" target="p10_s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10_e6" value="still failing" style="endArrow=block;html=1;dashed=1;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="p10_s6" target="p10_s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10_e7" value="still failing" style="endArrow=block;html=1;dashed=1;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="p10_s7" target="p10_s8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10_e8" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p10_s8" target="p10_s9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10_e9" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p10_s10" target="p10_s11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10_m1" value="PROVIDER ARCHITECTURE — app/infrastructure/llm/&#xa;&#xa;One OpenAICompatibleProvider class serves every vendor. Built on&#xa;the openai Python SDK with a swappable base_url — Groq, Gemini,&#xa;OpenRouter and local Ollama all plug in through the identical call&#xa;shape. A new vendor means a new base_url + model string, not a&#xa;new class." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="60" width="630" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p10_m2" value="WHY GROQ IS PRIMARY (real hardware constraint)&#xa;&#xa;llama-3.3-70b-versatile needs ~40GB of GPU memory — that&#xa;physically cannot run on the production VM. Frontier-quality&#xa;reasoning has to come from a cloud free tier instead of local&#xa;hardware. Free tier: ~1000 requests/day." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="216" width="630" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p10_m3" value="GEMINI — AUTOMATIC FALLBACK&#xa;&#xa;gemini-2.0-flash. Switches in automatically on Groq error or&#xa;quota exhaustion. Free tier: ~1500 requests/day. Also the path&#xa;that powers image / vision understanding across finzorr." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="362" width="630" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p10_m4" value="OPENROUTER — OPTIONAL EXTRA LAYER&#xa;&#xa;Free-tagged models only, no billing setup. An additional&#xa;fallback layer sitting between Gemini and the local emergency&#xa;tier." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="498" width="630" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p10_m5" value="OLLAMA — EMERGENCY FALLBACK&#xa;&#xa;llama3.2:3b-instruct-fp16, local. Kicks in only once every cloud&#xa;tier is exhausted. $0 marginal cost — answers slowly, but never&#xa;hard-fails the request." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="614" width="630" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p10_m6" value="EMBEDDINGS — ALWAYS LOCAL&#xa;&#xa;Ollama nomic-embed-text:v1.5. $0, every embedding call, every&#xa;route — embedding volume is too high and too cheap-per-call to&#xa;justify a cloud API." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="750" width="630" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p10_m7" value="DEV vs PROD MODEL DEFAULT&#xa;&#xa;Local development uses qwen2.5:14b-instruct via Ollama — not the&#xa;production Groq → Gemini → OpenRouter → Ollama chain. A&#xa;deliberately different default so devs get local reasoning&#xa;without touching cloud quotas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="876" width="630" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p10_r1" value="TRAFFIC SHAPING — RATE LIMITS &amp; DAILY BUDGETS&#xa;&#xa;Per-user Redis rate limits, plus a global per-provider daily&#xa;token budget, shift traffic down this fallback chain&#xa;automatically — BEFORE providers start hard-rejecting requests.&#xa;The Groq → Gemini → OpenRouter → Ollama cascade is triggered by&#xa;both provider errors / quota exhaustion AND finzorr&#39;s own&#xa;proactive budget shaping." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="60" width="630" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p10_r2" value="RESILIENCE — TIMEOUT INCIDENT (FIXED)&#xa;&#xa;Real bug, since fixed: the openai SDK&#39;s own default timeout is&#xa;600 seconds. That once let one hung provider call pin a WebSocket&#xa;slot for ten minutes — while tool calls elsewhere in finzorr are&#xa;capped at 20 seconds.&#xa;&#xa;Fix: an httpx timeout of 120s with a 10s connect timeout, set&#xa;once on the shared provider client class — every vendor inherits&#xa;it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="238" width="630" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p10_r3" value="PROVIDER CHAIN AT A GLANCE&#xa;&#xa;Role        Provider                Model                        Tier / Cost           Notes&#xa;PRIMARY     Groq                    llama-3.3-70b-versatile      ~1000 req/day free    70B needs ~40GB GPU, cloud-only&#xa;FALLBACK    Gemini                  gemini-2.0-flash             ~1500 req/day free    also the vision/image path&#xa;OPTIONAL    OpenRouter              free-tagged models only      no billing setup      extra fallback layer&#xa;EMERGENCY   Ollama (local)          llama3.2:3b-instruct-fp16    $0                    slow, never hard-fails&#xa;EMBEDDINGS  Ollama (local, always)  nomic-embed-text:v1.5        $0                    every embedding call, every route&#xa;DEV DEFAULT Ollama (local, dev)     qwen2.5:14b-instruct         $0                    not part of the prod chain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1060" y="468" width="630" height="240" as="geometry" />
        </mxCell>
        <mxCell id="p10_r4" value="LEGEND (colors restated)&#xa;&#xa;Teal = entry · Blue = process / reference · Green = LIVE, actually&#xa;built &amp; running · Yellow = decision / routing · Purple = output /&#xa;streamed result · Red = risk / warning / incident (fixed here) ·&#xa;Gray = dense reference panel · Amber dashed = PLANNED (unused on&#xa;this page — every component shown is live)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="728" width="630" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p11" name="11 . Evaluation, LLM-as-Judge and Observability">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p11_t" value="EVALUATION, LLM-AS-JUDGE &amp; OBSERVABILITY — deterministic gates before every release (scripts/release_gate.sh), daily drift detection, live production trace-health monitoring, and a human feedback loop that closes back to the exact trace." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1660" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p11_c1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="67" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p11_c2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="132" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p11_c3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="205" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p11_c4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="283" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p11_c5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="353" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p11_c6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="423" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p11_c7" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="485" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p11_c8" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="553" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p11_c9" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="629" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p11_c10" value="10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="695" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p11_c11" value="11" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="765" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p11_s1" value="Code change / PR opened" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="60" width="270" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p11_s2" value="scripts/release_gate.sh — THE documented pre-release command" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="118" width="270" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p11_s3" value="Static + unit gates: mypy strict → ruff → full pytest suite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="190" width="270" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p11_s4" value="Deterministic eval suite: routing_eval · injection_eval · plan_eval · rag_eval · grounded_eval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="264" width="270" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p11_s5" value="Gate: exit-on-first-failure — ship or block" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="346" width="270" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p11_s6" value="scripts/drift_watch.py — runs DAILY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="416" width="270" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p11_s7" value="Re-executes every deterministic eval · keeps JSON history · tracing pinned OFF (watcher itself can&#39;t leak data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="464" width="270" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p11_s8" value="Alert: exit code 1 on regression vs previous run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="546" width="270" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p11_s9" value="scripts/trace_health_watch.py — a genuinely different signal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="616" width="270" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p11_s10" value="Queries LIVE LangSmith: degraded / guard:suspicious tag RATE over a trailing window (real production traffic, not a re-run)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="672" width="270" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p11_s11" value="Alert on threshold breach · skips gracefully (exit 0) if tracing not configured" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="752" width="270" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p11_legend" value="LEGEND&#xa;&#xa;Teal = input / entry&#xa;Blue = process / service / reference&#xa;Green = LIVE — actually built &amp; running&#xa;Amber dashed = PLANNED / gap&#xa;Yellow = decision / routing / threshold logic&#xa;Purple = output / synthesis&#xa;Gray = dense reference / annotation panel&#xa;Red = risk / warning / hard-stop gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="816" width="270" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p11_e1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p11_s1" target="p11_s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11_e2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p11_s2" target="p11_s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11_e3" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p11_s3" target="p11_s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11_e4" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p11_s4" target="p11_s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11_e5" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p11_s6" target="p11_s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11_e6" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p11_s7" target="p11_s8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11_e7" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p11_s9" target="p11_s10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11_e8" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p11_s10" target="p11_s11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11_m1" value="DETERMINISTIC EVAL GATE RESULTS (real, recorded)&#xa;&#xa;Eval            Result                           Gate                    Status&#xa;routing_eval    47/50 = 94.0%                    ≥ 90%                   PASS&#xa;injection_eval  76/76 = 100%                     100%                    PASS&#xa;plan_eval       25/25 mechanics checks           100%                    PASS&#xa;rag_eval        15/15 hit-rate = 100%,           hit-rate ≥ 0.9,         PASS&#xa;                8.2/10 faithfulness              judge score ≥ 7&#xa;grounded_eval   citation / grounding checks      —                       part of release_gate.sh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="380" y="60" width="630" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p11_m2" value="PLAN_EVAL — LIVE LLM-JUDGE RUBRIC (separate from mechanics)&#xa;&#xa;Beyond the 25/25 mechanics checks, a live LLM-judge rubric runs&#xa;15 prompts across 3 rubrics. Mean score: 9.1/10.&#xa;Judge model: qwen2.5:14b-instruct." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="298" width="630" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p11_m3" value="RAG_EVAL THRESHOLDS&#xa;&#xa;Gate: minimum hit rate 0.9 AND minimum judge score 7.&#xa;Actual: 15/15 = 100% hit-rate, 8.2/10 faithfulness." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="424" width="630" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p11_m4" value="DRIFT WATCH vs TRACE HEALTH WATCH — two different signals&#xa;&#xa;drift_watch.py re-runs the deterministic evals DAILY against&#xa;static golden data, keeps JSON history, diffs against the&#xa;previous run — tracing is deliberately pinned OFF inside it so&#xa;the watcher itself cannot leak data.&#xa;&#xa;trace_health_watch.py is not a re-run at all: it queries LIVE&#xa;LangSmith for the degraded / guard:suspicious tag RATE over a&#xa;trailing window of real production traffic, alerts on threshold&#xa;breach, and skips gracefully (exit 0) if tracing isn&#39;t&#xa;configured." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="542" width="630" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p11_m5" value="LANGSMITH TRACING — OPT-IN BY DEFAULT&#xa;&#xa;LANGSMITH_TRACING defaults to false — prompts never leave the&#xa;server unless tracing is deliberately enabled. Real secrets live&#xa;only in a gitignored local .env file." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="770" width="630" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p11_r1" value="TRACING COMPLETENESS AUDIT — 6 blind spots closed&#xa;&#xa;6 choke-point decorators now cover ~20 call paths:&#xa;&#xa;1  Tool dispatcher — every tool call, dynamically named&#xa;2  Vision / image path — previously invisible&#xa;3  Background memory extraction + auto-titling — previously&#xa;   bare, unnamed roots&#xa;4  Scheduled / resumed turns — tagged with an origin&#xa;   (chat / scheduled / resume), distinct from live chat&#xa;5  Web search + embedding calls — traced as retriever /&#xa;   embedding runs&#xa;6  Noisy trace inputs cleaned up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="60" width="630" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p11_r2" value="FEEDBACK LOOP — LIVE, closes to the exact trace&#xa;&#xa;Thumbs up/down fires a create_feedback call — fire-and-forget,&#xa;never blocks the response — onto a pre-assigned LangSmith run id&#xa;persisted on the message row. That closes the loop from user&#xa;feedback all the way to the exact trace." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="338" width="630" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p11_r3" value="GOLDEN DATASET PROMOTION — MANUAL, NOT YET AUTOMATED&#xa;&#xa;Promoting thumbs-down items into the golden eval dataset is a&#xa;manual, weekly process today — honestly not automated yet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#d79b00;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="486" width="630" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p11_legend2" value="LEGEND (colors restated)&#xa;&#xa;Teal = entry · Blue = process / reference · Green = LIVE, actually&#xa;built &amp; running · Yellow = decision / routing / threshold logic ·&#xa;Red = risk / warning / hard-stop gate · Gray = dense reference&#xa;panel · Amber dashed = PLANNED / gap (golden-dataset promotion is&#xa;the one honest gap on this page)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="594" width="630" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p12" name="12 . Deployment, Security, HA/DR &amp; LLMOps">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1660" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p12_t" value="PRODUCTION DEPLOYMENT, SECURITY, HA/DR &amp; LLMOPS — finzorr.ai&#39;s real production stack on an OVH server behind Cloudflare, the real OWASP LLM Top 10 disposition, and every incident actually hit and fixed in production. Green = LIVE, amber dashed = honest open gap." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1660" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p12_sub1" value="PRODUCTION ARCHITECTURE — OVH dedicated server, docker-compose.prod.yml, six containers, zero published ports" style="text;html=1;fontSize=12;fontStyle=1;align=left;fontColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="30" y="46" width="1000" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p12_user" value="User&#xa;browser / SPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p12_pages" value="Cloudflare Pages (frontend)&#xa;&#xa;Static build hosted at finzorr.ai + www.finzorr.ai — custom domain binding&#xa;&#xa;Deploy: npm run build → wrangler pages deploy (Wrangler CLI) — MANUAL, no CI step. Every frontend deploy is a deliberate command." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="75" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p12_tunnel" value="Cloudflare Tunnel (ingress)&#xa;&#xa;STRICTLY OUTBOUND from the server — cloudflared polls Cloudflare; nothing listens for inbound connections&#xa;&#xa;Routes api.finzorr.ai → api container. Cloudflare terminates HTTPS — no certificates to manage on the server." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="75" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p12_compose" value="docker-compose.prod.yml&#xa;&#xa;6 containers on an OVH dedicated server. NO published ports anywhere — everything is on the internal Docker network only&#xa;&#xa;Named volumes: finzorr_pgdata, finzorr_qdrant, finzorr_ollama, finzorr_uploads — data survives redeploys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="800" y="75" width="310" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p12_n1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="187" y="63" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p12_n2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="477" y="63" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p12_n3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="17" y="233" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p12_n4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="289" y="233" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p12_n5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="561" y="233" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p12_c_cf" value="cloudflared&#xa;~0.1GB&#xa;Tunnel daemon — polls Cloudflare outbound only, same shape as the CD runner below" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="245" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p12_c_api" value="api (FastAPI)&#xa;~1.5GB · 2 uvicorn workers&#xa;Serves api.finzorr.ai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="302" y="245" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p12_c_pg" value="postgres&#xa;pgvector/pgvector:pg16&#xa;~0.7GB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="574" y="245" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p12_c_redis" value="redis&#xa;~0.4GB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="846" y="245" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p12_c_qdrant" value="qdrant&#xa;~0.5GB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1118" y="245" width="260" height="100" as="geometry" />
