        <mxCell id="p20_ex_spec_lbl" value="SPECULATIVE DECODING — one draft batch" style="text;html=1;fontSize=11;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="1514" width="510" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p20_ex_spec1" value="Draft model guesses [&quot;the&quot;,&quot;portfolio&quot;,&quot;gained&quot;,&quot;3&quot;]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
