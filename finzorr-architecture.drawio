        <mxCell id="p3_be" value="FastAPI app — app/interface/&#xa;Routers + the /ws/chat WebSocket handler; thin, delegates to orchestration. Auth: Google OAuth ID-token verification + JWT session cookie (Domain=.finzorr.ai)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
